---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
---

<PageLayout title="Travel" description="Places I have visited, measured at country, planetary, and galactic scales.">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
  <TopLayout>
    <div class="animate max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-300/65">A small expansion program</p>
      <h1 class="mt-3 text-4xl font-semibold text-white">Travel</h1>
      <p class="mt-4 text-lg leading-relaxed text-white/55">Traveling to all 195 United Nations-recognized countries still seems doable, especially with a few bursts of travel, cheaper trips in the future, and improved conditions in many currently disadvantaged countries.</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <section class="animate progress-grid" aria-label="Travel progress">
      <div class="progress-card">
        <div><span>Country Progress</span><strong id="country-progress-value">19.0%</strong></div>
        <div class="progress-track"><i id="country-progress-bar" style="width:19%"></i></div>
        <small>195 recognized countries</small>
      </div>
      <div class="progress-card">
        <div><span>Planetary Progress</span><strong>12.5%</strong></div>
        <div class="progress-track"><i style="width:12.5%"></i></div>
        <small>One planet, incompletely explored</small>
      </div>
      <div class="progress-card">
        <div><span>Galactic Progress</span><strong>≈ 0%</strong></div>
        <div class="progress-track"><i style="width:0.15%"></i></div>
        <small>Approximately 100 billion stars remaining</small>
      </div>
    </section>
    <section class="animate mt-8">
      <div id="map" aria-label="Map of places Jordan has visited"></div>
    </section>
  </BottomLayout>
  <script is:inline src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
  <script is:inline src="/locations.js"></script>
  <script is:inline src="/travel.js"></script>
</PageLayout>

<style>
  .progress-grid { @apply grid gap-4 md:grid-cols-3; }
  .progress-card { @apply rounded-2xl border border-white/15 bg-white/[0.03] p-5; }
  .progress-card > div:first-child { @apply flex items-center justify-between gap-4; }
  .progress-card span { @apply text-sm font-semibold text-white; }
  .progress-card strong { @apply text-sm text-violet-200; }
  .progress-card small { @apply mt-3 block text-xs text-white/35; }
  .progress-track { @apply mt-4 h-1.5 overflow-hidden rounded-full bg-white/10; }
  .progress-track i { @apply block h-full rounded-full bg-gradient-to-r from-violet-500 to-cyan-300; }
  #map { @apply h-[620px] overflow-hidden rounded-2xl border border-white/15 bg-white/5; }
  :global(.leaflet-control-attribution) { background: rgba(0,0,0,.65) !important; color: rgba(255,255,255,.5); }
  :global(.leaflet-control-attribution a) { color: rgba(196,181,253,.9); }
</style>
