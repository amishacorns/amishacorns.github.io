---
import { getCollection } from "astro:content"
import { readFileSync } from "node:fs"
import { parse } from "yaml"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import ArrowCard from "@components/ArrowCard.astro"
import { formatDate, readingTime } from "@lib/utils"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({
    params: { slug: post.data.permalink.replace(/^\/posts\//, "").replace(/\/$/, "") },
    props: post,
  }))
}

const post = Astro.props
const { Content } = await post.render()
const { title, description, date, tags, header } = post.data
const isYannLeCant = post.data.permalink === "/posts/yann-lecant/"
type Quote = { text: string; context?: string; source: string; url?: string; date: string; section: string }
type SectionResponse = { section: string; text: string }
type Person = { name: string; title: string; handle: string; role: string; blurb: string; quotes: Quote[]; section_responses: SectionResponse[] }
const wallData = isYannLeCant
  ? parse(readFileSync(new URL("../../../_data/wall_of_shame.yml", import.meta.url), "utf8")) as { people: Person[] }
  : null
const yannIntro = "The point isn't that smart people are sometimes wrong, or that strong opinions should be kept private. The problem is what happens when a leader in AI keeps turning the limitations of one implementation into limits of the entire field, ignores weak exponential improvements as they compound, and uses that confidence to dismiss safety work as premature. A bad prediction is harmless. Negligence about a technology moving this quickly isn't, especially when the person making it has the influence to shape what researchers, companies, and governments take seriously. Every quote below links to the best source I could find.*"
const readingSource = wallData
  ? [yannIntro, ...wallData.people.flatMap((person) => [
      person.title,
      person.role,
      person.blurb,
      ...person.quotes.flatMap((quote) => [quote.context ?? "", quote.text, quote.source]),
      ...person.section_responses.map((response) => response.text),
    ])].join(" ")
  : post.body
const sectionsFor = (person: Person) => {
  const names = [...new Set(person.quotes.map((quote) => quote.section))]
  return names.map((name) => ({
    name,
    quotes: person.quotes.filter((quote) => quote.section === name),
    response: person.section_responses.find((response) => response.section === name)?.text,
  }))
}
const allPosts = (await getCollection("blog"))
  .filter((entry) => !entry.data.draft && entry.slug !== post.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const related = allPosts.filter((entry) => entry.data.tags.some((tag) => tags.includes(tag))).slice(0, 3)
if (related.length < 3) {
  for (const entry of allPosts) {
    if (related.length >= 3) break
    if (!related.some((item) => item.slug === entry.slug)) related.push(entry)
  }
}
---

<PageLayout
  title={title}
  description={description}
  image={header?.teaser ? `/images/${header.teaser}` : undefined}
  imageAlt={title}
  type="article"
  publishedTime={date.toISOString()}
  tags={tags}
>
  <div class="pt-28 pb-16">
    <Container size="md">
      <a href="/transmissions" class="back-link">← All Transmissions</a>

      <header class="animate article-header">
        {header?.teaser && (
          <div class="hero-art"><img src={`/images/${header.teaser}`} alt="" loading="eager" fetchpriority="high" decoding="async" /></div>
        )}
        <div class="mt-8 flex flex-wrap gap-3 text-xs uppercase tracking-[0.12em] text-white/45">
          <span>{formatDate(date)}</span>
          <span>·</span>
          <span>{readingTime(readingSource)}</span>
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </header>

      <article class="animate article-body">
        {isYannLeCant && wallData ? (
          <div class="prediction-ledger">
            <p class="ledger-intro">{yannIntro}</p>
            {wallData.people.map((person) => (
              <section class="ledger-person">
                <h2>{person.title}</h2>
                <p class="ledger-role"><a href={`https://x.com/${person.handle.replace("@", "")}`}>{person.handle}</a> · {person.role}</p>
                <p class="ledger-blurb">{person.blurb}</p>
                {sectionsFor(person).map((section) => (
                  <div class="ledger-section">
                    <h3>{section.name}</h3>
                    {section.quotes.map((quote) => (
                      <blockquote>
                        {quote.context && <p class="quote-context">{quote.context}</p>}
                        <p class="quote-text">“{quote.text.replace(/\s+/g, " ").trim()}”</p>
                        <cite>— {person.name}, {quote.url ? <a href={quote.url}>{quote.source}</a> : quote.source}, {quote.date}</cite>
                      </blockquote>
                    ))}
                    {section.response && <div class="section-response"><strong>Response:</strong> {section.response}</div>}
                  </div>
                ))}
              </section>
            ))}
            <p class="ledger-footnote">* This page was assembled with help from an LLM. Due to the major limitations of LLMs, it can hallucinate. If one of these quotes is fake, the LLM has accidentally made Yann LeCun's point for him.</p>
          </div>
        ) : <Content />}
      </article>

      <section class="animate mt-20 border-t border-white/15 pt-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-300/65">Continue the signal</p>
        <h2 class="mt-2 text-2xl font-semibold text-white">You may also enjoy</h2>
        <ul class="mt-6 space-y-4">
          {related.map((entry) => <li><ArrowCard entry={entry} /></li>)}
        </ul>
      </section>
    </Container>
  </div>
</PageLayout>

<style>
  .back-link { @apply inline-flex rounded-full border border-white/15 px-3 py-1.5 text-sm text-white/55 hover:border-violet-300/40 hover:text-white transition-colors; }
  .article-header { @apply mx-auto mt-10 max-w-3xl; }
  .hero-art { @apply overflow-hidden rounded-2xl border border-white/15 bg-white/5; }
  .hero-art img { @apply block max-h-[620px] w-full object-contain; }
  .article-header h1 { @apply mt-3 text-3xl md:text-5xl font-semibold leading-tight text-white; }
  .article-header > p { @apply mt-4 max-w-2xl text-lg leading-relaxed text-white/55; }
  .article-header li { @apply rounded-full bg-white/10 px-2.5 py-1 text-xs uppercase tracking-wide text-white/60; }
  .article-body { @apply mx-auto mt-14 max-w-3xl; }
  .prediction-ledger { @apply text-base leading-relaxed text-white/70; }
  .ledger-intro { @apply text-lg leading-relaxed text-white/75; }
  .ledger-person { @apply mt-16 border-t border-white/15 pt-10; }
  .ledger-person h2 { @apply text-3xl font-semibold text-white; }
  .ledger-role { @apply mt-2 text-sm text-white/45; }
  .ledger-role a { @apply text-violet-300 hover:text-violet-200; }
  .ledger-blurb { @apply mt-5 text-lg italic text-white/60; }
  .ledger-section { @apply mt-12; }
  .ledger-section h3 { @apply text-xl font-semibold text-white; }
  .ledger-section blockquote { @apply my-5 rounded-r-xl border-l-4 border-violet-400/70 bg-white/[0.045] px-5 py-4; }
  .quote-context { @apply mb-3 text-sm italic text-white/45; }
  .quote-text { @apply text-lg leading-relaxed text-white/85; }
  .ledger-section cite { @apply mt-3 block text-sm not-italic text-white/45; }
  .ledger-section cite a { @apply text-violet-300 underline decoration-violet-300/30 underline-offset-4 hover:text-violet-200; }
  .section-response { @apply mt-6 rounded-xl border border-white/10 bg-violet-300/[0.07] px-5 py-4 text-white/70; }
  .section-response strong { @apply text-white; }
  .ledger-footnote { @apply mt-16 border-t border-white/15 pt-6 text-sm italic text-white/45; }
</style>
