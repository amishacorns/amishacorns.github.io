---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard.astro"
import MeteorShower from "@components/MeteorShower.astro"
import IdentityComets from "@components/IdentityComets.astro"
import EarthGlobe from "@components/EarthGlobe.astro"
import CosmicCountdowns from "@components/CosmicCountdowns.astro"
import SingularityBlackHole from "@components/SingularityBlackHole.astro"
import AGIImpactAsteroid from "@components/AGIImpactAsteroid.astro"
import OrbitSequenceController from "@components/home/OrbitSequenceController.astro"
import EngagementAnalyticsController from "@components/home/EngagementAnalyticsController.astro"
import OrbitalFocusController from "@components/home/OrbitalFocusController.astro"
import TravelIndexController from "@components/home/TravelIndexController.astro"
import DeferredImagesController from "@components/home/DeferredImagesController.astro"
import { SITE } from "@consts"
import locations from "../data/locations.json"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const selectedPaths = ["/posts/paths/", "/posts/is-sometime-now/", "/posts/granny/"]
const selected = selectedPaths
  .map((path) => posts.find((post) => post.data.permalink === path))
  .filter((post): post is (typeof posts)[number] => Boolean(post))

const featured = [
  { label: "The path", path: "/posts/paths/", image: "/images/critical-card.webp" },
  { label: "The danger", path: "/posts/is-sometime-now/", image: "/images/is-sometime-now-card.webp" },
  { label: "The destination", path: "/posts/granny/", image: "/images/granny-family-card.webp" },
]

const continentOrder = ["North America", "South America", "Europe", "Africa", "Asia"]
const continentByCountry: Record<string, string> = {
  Argentina: "South America",
  Austria: "Europe",
  Belgium: "Europe",
  Cambodia: "Asia",
  Canada: "North America",
  China: "Asia",
  Colombia: "South America",
  "Costa Rica": "North America",
  "Dominican Republic": "North America",
  Egypt: "Africa",
  "El Salvador": "North America",
  France: "Europe",
  Germany: "Europe",
  Guatemala: "North America",
  Hungary: "Europe",
  Italy: "Europe",
  Jamaica: "North America",
  Japan: "Asia",
  Mexico: "North America",
  Norway: "Europe",
  Panama: "North America",
  Philippines: "Asia",
  Poland: "Europe",
  Portugal: "Europe",
  "Puerto Rico": "North America",
  Singapore: "Asia",
  "South Korea": "Asia",
  Spain: "Europe",
  Switzerland: "Europe",
  Taiwan: "Asia",
  Thailand: "Asia",
  Turkey: "Asia",
  UAE: "Asia",
  UK: "Europe",
  USA: "North America",
  Uruguay: "South America",
  "Virgin Islands": "North America",
}
const countryNames: Record<string, string> = {
  UAE: "United Arab Emirates",
  UK: "United Kingdom",
  USA: "America",
}
const countryLocations = new Map<string, { lat: number; lng: number; count: number }>()
locations.forEach((location) => {
  const country = location.title.split(",").at(-1)?.trim()
  if (!country) return
  const current = countryLocations.get(country) ?? { lat: 0, lng: 0, count: 0 }
  current.lat += location.lat
  current.lng += location.lng
  current.count += 1
  countryLocations.set(country, current)
})
const countryGroups = continentOrder.map((continent) => ({
  continent,
  countries: [...countryLocations.entries()]
    .filter(([country]) => continentByCountry[country] === continent)
    .map(([country, target]) => ({
      name: countryNames[country] ?? country,
      lat: target.lat / target.count,
      lng: target.lng / target.count,
    }))
    .sort((a, b) => a.name.localeCompare(b.name)),
}))
const countryCount = countryLocations.size
const countryProgress = ((countryCount / 195) * 100).toFixed(1)
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <section id="orbit" class="orbit-section relative w-full">
    <div id="orbit-stage" class="sticky top-0 h-screen min-h-[680px] w-full overflow-hidden">
    <div id="galaxy" class="absolute inset-0 pointer-events-none">
      <MeteorShower />
    </div>
    <SingularityBlackHole />
    <CosmicCountdowns />

    <div id="planetcont" class="animate absolute inset-0 top-[28%] overflow-visible">
      <div id="crescent" class="absolute top-0 left-1/2 -translate-x-1/2 w-[165vw] min-h-[100vh] aspect-square rounded-full p-px bg-gradient-to-b from-white/70 from-0% to-transparent to-[6%]">
        <div id="planet" class="relative z-10 w-full h-full bg-black rounded-full p-px overflow-hidden flex justify-center">
          <div class="earth-rotation" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
          <EarthGlobe />
          <div class="earth-shadow" aria-hidden="true"></div>
          <div id="blur" class="relative z-10 w-full h-20 rounded-full bg-violet-300/20 blur-3xl"></div>
        </div>
        <div id="orbiting-objects" class="absolute inset-0">
          <IdentityComets />
          <AGIImpactAsteroid />
        </div>
      </div>
    </div>

    <div id="orbit-copy" class="animate pointer-events-none absolute inset-0 z-30 flex items-center justify-center">
      <div class="relative px-5 text-center -translate-y-6">
        <p class="animated hero-kicker">Agent Architect</p>
        <h1 class="animated hero-name">Jordan Dotzel</h1>
        <div id="ctaButtons" class="animated pointer-events-auto flex flex-wrap gap-3 justify-center mt-8">
          <a href="/transmissions" class="hero-primary" onclick="plausible('Read Transmissions')">Read Transmissions</a>
          <a href="/research" class="hero-secondary" onclick="plausible('View Research')">View Research</a>
        </div>
      </div>
    </div>

    <div id="orbit-progress" class="orbit-progress" aria-label="Travel progress">
      <button type="button" class="orbit-progress-item" data-orbit-panel="countries" aria-haspopup="dialog" aria-expanded="false">
        <div><span>Countries</span><strong>{countryProgress}%</strong></div>
        <div class="orbit-progress-track"><i style={`width:${countryProgress}%`}></i></div>
      </button>
      <button type="button" class="orbit-progress-item" data-orbit-panel="planetary" aria-haspopup="dialog" aria-expanded="false">
        <div><span>Planets</span><strong>12.5%</strong></div>
        <div class="orbit-progress-track"><i style="width:12.5%"></i></div>
      </button>
      <button type="button" class="orbit-progress-item" data-orbit-panel="galactic" aria-haspopup="dialog" aria-expanded="false">
        <div><span>Galaxies</span><strong>≈ 0%</strong></div>
        <div class="orbit-progress-track"><i style="width:0.15%"></i></div>
      </button>
      <button id="globe-pause-button" class="orbit-pause-button" type="button" aria-label="Pause Earth rotation" aria-pressed="false">
        <svg class="pause-icon" viewBox="0 0 12 12" aria-hidden="true">
          <rect x="2.25" y="1.5" width="2.5" height="9" rx="0.75"></rect>
          <rect x="7.25" y="1.5" width="2.5" height="9" rx="0.75"></rect>
        </svg>
        <svg class="play-icon" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M3 1.7 10 6 3 10.3V1.7Z"></path>
        </svg>
      </button>

    <div id="orbit-panel" class="orbit-panel" role="dialog" aria-modal="false" aria-labelledby="orbit-panel-title" hidden>
      <div class="orbit-panel-header">
        <div>
          <p class="orbit-panel-kicker">Travel Index</p>
          <h2 id="orbit-panel-title">Countries</h2>
        </div>
        <button id="orbit-panel-close" type="button" aria-label="Close travel index">×</button>
      </div>

      <div class="orbit-panel-body">
        <section data-orbit-panel-content="countries">
          <p class="orbit-panel-note">{countryCount} countries. Choose one to rotate the globe.</p>
          <div class="continent-list">
            {countryGroups.map((group) => (
              <details class="continent-group">
                <summary>
                  <span>{group.continent}</span>
                  <small>{group.countries.length}</small>
                </summary>
                <div class="country-grid">
                  {group.countries.map((country) => (
                    <button
                      type="button"
                      class="orbit-destination"
                      data-globe-lat={country.lat}
                      data-globe-lng={country.lng}
                    >
                      {country.name}
                    </button>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        <section data-orbit-panel-content="planetary" hidden>
          <p class="orbit-panel-note">Known planetary destinations.</p>
          <button type="button" class="cosmic-destination orbit-destination" data-globe-lat="20" data-globe-lng="0">
            <span>Earth</span><small>1 of 8 planets</small>
          </button>
        </section>

        <section data-orbit-panel-content="galactic" hidden>
          <p class="orbit-panel-note">Known galactic destinations.</p>
          <div class="cosmic-destination cosmic-destination-static">
            <span>Milky Way</span><small>1 of approximately 2 trillion galaxies</small>
          </div>
        </section>
      </div>
    </div>
    </div>

    <div id="orbit-prompt" class="absolute inset-x-0 bottom-7 z-30 flex justify-center text-xs uppercase tracking-[0.24em] text-white/45">
      Scroll to enter orbit
    </div>
    </div>
  </section>

  <div id="main-content" class="relative border-t border-white/10 bg-black/80">
    <div class="mx-auto max-w-screen-md px-5 pt-14 pb-24 space-y-28">
      <section class="grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="section-number">01 / Now</p>
          <h2 class="section-title">The Age of Machine Intelligence.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-white/70">
          <p>We are currently within the most dynamic and exciting era of human discovery. The number of unanswered questions remains high, and the tools required to probe them are finally being built.</p>
          <p>General artificial intelligence now has most of its necessary ingredients. It may create the most incredible benefits across society while also becoming the most destabilizing and dangerous technology ever created.</p>
          <p class="text-white">The decisions we make now will lead to a society that eventually flourishes, decays, or disappears.</p>
        </div>
      </section>

      <section>
        <div class="section-heading-row">
          <div>
            <p class="section-number">02 / Selected Transmissions</p>
            <h2 class="section-title">Transmissions</h2>
          </div>
          <a class="section-link" href="/transmissions">All Transmissions →</a>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {selected.map((post) => {
            const art = featured.find((item) => item.path === post.data.permalink)
            return (
              <a class="featured-card" href={post.data.permalink}>
                <div class="featured-image">
                  <img data-deferred-src={art?.image} alt="" width="800" height="600" loading="eager" decoding="async" />
                </div>
                <div class="p-5">
                  <p class="text-xs uppercase tracking-[0.18em] text-violet-300/75">{art?.label}</p>
                  <h3 class="mt-2 text-lg font-semibold text-white">{post.data.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/55">{post.data.description}</p>
                </div>
              </a>
            )
          })}
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="section-number">03 / Research</p>
          <h2 class="section-title">Efficient Intelligence.</h2>
        </div>
        <div>
          <p class="text-lg leading-relaxed text-white/70">My academic research focused on building more efficient deep learning systems through neural architecture design, low-precision quantization, and dynamic sparsity. The current work moves further up the stack: agents, thought traces, and the systems that will build whatever comes next.</p>
          <div class="mt-7 grid gap-3">
            <a class="signal-row" href="https://arxiv.org/abs/2308.03290" target="_blank">
              <span><b>FLIQS</b><small>Best Paper · AutoML 2024</small></span><span>↗</span>
            </a>
            <a class="signal-row" href="https://arxiv.org/abs/2405.03103" target="_blank">
              <span><b>Learning from Students</b><small>ICML 2024</small></span><span>↗</span>
            </a>
            <a class="signal-row" href="https://arxiv.org/abs/2404.04900" target="_blank">
              <span><b>Radial Networks</b><small>Dynamic routing for large language models</small></span><span>↗</span>
            </a>
          </div>
          <a class="section-link mt-6 inline-flex" href="/research">Research and Experience →</a>
        </div>
      </section>

      <section>
        <div class="section-heading-row">
          <div>
            <p class="section-number">04 / Recent Transmissions</p>
            <h2 class="section-title">Latest</h2>
          </div>
        </div>
        <ul class="mt-8 space-y-4">
          {posts.slice(0, 4).map((post) => <li><ArrowCard entry={post} /></li>)}
        </ul>
      </section>

    </div>
  </div>
</PageLayout>

<DeferredImagesController />

<style>
  .orbit-section {
    height: 126vh;
  }

  #main-content {
    margin-top: -50vh;
  }

  #orbit-stage { isolation: isolate; }

  :global(#orbit-stage.orbit-scrolling :is(.accretion-disk-back, .accretion-disk::before, .identity-trail-dust)) {
    animation-play-state: paused !important;
  }

  :global(#orbit-stage[data-orbital-focus="agi"] :is(#planet, #orbit-copy, #orbit-progress, #orbit-prompt, #deep-singularity, #cosmic-events, .identity-comet:not(.agi-impact-comet), .identity-trails)),
  :global(#orbit-stage[data-orbital-focus="singularity"] :is(#crescent, #orbit-copy, #orbit-progress, #orbit-prompt, #inbound-agi, #cosmic-events)) {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 220ms ease;
  }

  :global(#orbit-stage[data-orbital-focus="agi"] #crescent) {
    background: transparent !important;
  }

  :global(#orbit-stage.orbital-returning :is(#crescent, #orbit-copy, #orbit-progress, #orbit-prompt, #deep-singularity, #inbound-agi, #cosmic-events)) {
    transition: opacity 720ms ease !important;
  }

  :global(#orbit-stage.orbital-returning #deep-singularity) {
    transition:
      right 720ms cubic-bezier(0.4, 0, 0.2, 1),
      top 720ms cubic-bezier(0.4, 0, 0.2, 1),
      width 720ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 720ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 620ms ease;
  }

  #crescent {
    --orbit-scale: 1;
    --orbit-x: 0vw;
    --orbit-y: 0vh;
    transform: translate3d(calc(-50% + var(--orbit-x)), var(--orbit-y), 0) scale(var(--orbit-scale));
    transform-origin: 50% 0%;
    will-change: transform, opacity;
  }

  #orbiting-objects {
    will-change: opacity;
  }

  #orbit-copy,
  #orbit-progress,
  #orbit-prompt {
    will-change: opacity;
  }

  .hero-kicker { @apply font-semibold uppercase tracking-[0.24em] text-violet-200/70; font-size: 0.819rem; }
  .hero-name { @apply mt-3 font-bold uppercase tracking-[0.04em] text-white; font-size: 2.458rem; }
  @media (min-width: 768px) {
    .hero-kicker { font-size: 0.95rem; }
    .hero-name { font-size: 4.097rem; }
  }
  @media (min-width: 1024px) {
    .hero-name { font-size: 4.916rem; }
  }
  .hero-primary { @apply rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black hover:bg-violet-100 transition-colors; }
  .hero-secondary { @apply rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors; }
  .orbit-progress { @apply absolute bottom-16 left-1/2 z-30 grid w-[min(820px,calc(100%-2rem))] -translate-x-1/2 grid-cols-[repeat(3,minmax(0,1fr))_auto] gap-2 overflow-visible; }
  .orbit-progress-item { @apply pointer-events-auto rounded-xl border border-white/15 bg-black/35 px-3 py-2.5 text-left backdrop-blur-md transition hover:border-violet-200/40 hover:bg-white/10; }
  .orbit-progress-item[aria-expanded="true"] { @apply border-violet-200/55 bg-violet-300/10; }
  .orbit-progress-item > div:first-child { @apply flex items-center justify-between gap-2; }
  .orbit-progress-item span { @apply text-[10px] font-semibold uppercase tracking-[0.16em] text-white/50; }
  .orbit-progress-item strong { @apply text-xs font-semibold text-violet-100/85; }
  #globe-pause-button { @apply pointer-events-auto flex h-full min-h-11 w-11 items-center justify-center rounded-xl border border-white/15 bg-black/35 text-white/55 backdrop-blur-md transition-colors hover:border-violet-200/45 hover:bg-white/10 hover:text-white; }
  #globe-pause-button svg { @apply size-2.5 fill-current; }
  #globe-pause-button .play-icon { @apply hidden; }
  #globe-pause-button[data-paused="true"] .pause-icon { @apply hidden; }
  #globe-pause-button[data-paused="true"] .play-icon { @apply block; }
  .orbit-progress-track { @apply mt-2 h-px overflow-hidden rounded-full bg-white/15; }
  .orbit-progress-track i { @apply block h-full rounded-full bg-gradient-to-r from-violet-400 to-cyan-300; }
  .orbit-panel {
    @apply absolute z-40 overflow-hidden rounded-xl border border-white/20 bg-black/80 shadow-2xl shadow-violet-950/40 backdrop-blur-xl;
    bottom: calc(100% + 0.45rem);
    left: var(--orbit-panel-left, 0px);
    width: var(--orbit-panel-width, 15rem);
    max-height: var(--orbit-panel-max-height, min(58vh, 620px));
    clip-path: inset(94% 0 0 round 0.75rem);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.65rem) scaleY(0.08);
    transform-origin: 50% 100%;
    transition:
      clip-path 560ms cubic-bezier(0.2, 0.78, 0.18, 1),
      transform 560ms cubic-bezier(0.2, 0.78, 0.18, 1),
      opacity 180ms ease;
  }
  .orbit-panel[data-open="true"] {
    clip-path: inset(0 round 0.75rem);
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scaleY(1);
  }
  .orbit-panel[hidden] { display: none; }
  .orbit-panel-header { @apply flex items-center justify-between border-b border-white/10 px-4 py-3; }
  .orbit-panel-kicker { @apply text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-300/65; }
  .orbit-panel-header h2 { @apply mt-1 text-xl font-semibold text-white; }
  #orbit-panel-close { @apply flex size-8 items-center justify-center rounded-full border border-white/15 text-xl leading-none text-white/55 transition hover:border-white/40 hover:bg-white/10 hover:text-white; }
  .orbit-panel-body { @apply overflow-y-auto p-3; max-height: calc(var(--orbit-panel-max-height, min(58vh, 620px)) - 66px); }
  .orbit-panel-note { @apply mb-3 text-sm text-white/50; }
  .continent-list { @apply space-y-2; }
  .continent-group { @apply overflow-hidden rounded-xl border border-white/10 bg-white/[0.035]; }
  .continent-group summary { @apply flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-white/80 transition hover:bg-white/[0.055] hover:text-white; }
  .continent-group summary::-webkit-details-marker { display: none; }
  .continent-group summary::before { content: "+"; @apply mr-2 text-violet-300/65; }
  .continent-group[open] summary::before { content: "−"; }
  .continent-group summary small { @apply ml-auto text-xs font-normal text-white/35; }
  .country-grid { @apply grid grid-cols-1 gap-1 border-t border-white/10 p-2; }
  .continent-group[open] .country-grid {
    overflow: hidden;
    transition: height 650ms cubic-bezier(0.4, 0, 0.2, 1), opacity 480ms ease;
  }
  .orbit-destination { @apply rounded-lg px-3 py-2 text-left text-sm text-white/65 transition hover:bg-violet-300/10 hover:text-white; }
  .cosmic-destination { @apply flex w-full items-center justify-between rounded-xl border border-white/10 bg-white/[0.035] px-4 py-4 text-left transition; }
  button.cosmic-destination:hover { @apply border-violet-200/35 bg-violet-300/10; }
  .cosmic-destination span { @apply text-base font-semibold text-white; }
  .cosmic-destination small { @apply text-xs text-white/40; }
  .cosmic-destination-static { @apply cursor-default; }
  .section-number { @apply text-xs font-semibold uppercase tracking-[0.2em] text-violet-300/65; }
  .section-title { @apply mt-2 text-2xl md:text-3xl font-semibold text-white; }
  .section-heading-row { @apply flex flex-wrap items-end justify-between gap-5; }
  .section-link { @apply text-sm text-white/60 underline decoration-white/20 underline-offset-4 hover:text-white hover:decoration-white/60 transition-colors; }
  .featured-card { @apply overflow-hidden rounded-2xl border border-white/15 bg-white/[0.035] hover:-translate-y-1 hover:border-violet-300/40 hover:bg-white/[0.06] transition-all duration-300; }
  .featured-image { @apply aspect-[4/3] overflow-hidden border-b border-white/10 bg-white/5; }
  .featured-image img { @apply h-full w-full object-cover opacity-80 grayscale-[15%] transition duration-500; }
  .featured-card:hover img { @apply opacity-100 scale-[1.03] grayscale-0; }
  .signal-row { @apply flex items-center justify-between rounded-xl border border-white/15 bg-white/[0.025] px-4 py-3 text-white/65 hover:border-violet-300/40 hover:bg-white/[0.06] hover:text-white transition-colors; }
  .signal-row span:first-child { @apply flex min-w-0 flex-col; }
  .signal-row b { @apply truncate text-sm font-semibold text-white; }
  .signal-row small { @apply truncate text-xs text-white/45; }

  .earth-rotation {
    @apply absolute inset-0 flex;
    width: 200%;
    opacity: 0.72;
    filter: saturate(0.7) brightness(0.77) contrast(1.18);
    animation: earth-rotation 138.462s linear infinite reverse;
    will-change: transform;
    transition: opacity 900ms ease;
  }

  .globe-ready .earth-rotation { opacity: 0; }

  .earth-rotation span {
    width: 50%;
    height: 100%;
    flex: none;
    background-image: url('/images/earth-night-nasa-2k.webp');
    background-position: center top;
    background-repeat: no-repeat;
    background-size: 100% auto;
  }

  .earth-shadow {
    @apply absolute inset-0;
    background:
      radial-gradient(ellipse at 50% 0%, rgb(0 0 0 / 0.01) 0%, rgb(0 0 0 / 0.06) 34%, rgb(0 0 0 / 0.48) 74%),
      linear-gradient(to bottom, rgb(2 6 23 / 0.03), #000 91%);
  }

  @keyframes earth-rotation {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .earth-rotation { animation: none; }
  }

  @media (max-width: 640px) {
    .orbit-section {
      height: 138vh;
    }
    .orbit-progress { @apply gap-1.5; }
    .orbit-progress-item { @apply px-2 py-2; }
    .orbit-progress-item span { @apply text-[8px] tracking-[0.1em]; }
    .orbit-progress-item strong { @apply text-[10px]; }
    #globe-pause-button { @apply min-h-9 w-9; }
    .orbit-panel { max-height: var(--orbit-panel-max-height, 64vh); }
    .orbit-panel-body { max-height: calc(var(--orbit-panel-max-height, 64vh) - 66px); }
  }
</style>

<OrbitSequenceController />

<EngagementAnalyticsController />

<OrbitalFocusController />

<TravelIndexController />
