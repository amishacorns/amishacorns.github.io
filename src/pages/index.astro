---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import RealStarField from "@components/RealStarField.astro"
import MeteorShower from "@components/MeteorShower.astro"
import IdentityComets from "@components/IdentityComets.astro"
import EarthGlobe from "@components/EarthGlobe.astro"
import { SITE, SOCIALS } from "@consts"
import locations from "../data/locations.json"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const selectedPaths = ["/posts/paths/", "/posts/is-sometime-now/", "/posts/granny/"]
const selected = selectedPaths
  .map((path) => posts.find((post) => post.data.permalink === path))
  .filter((post): post is (typeof posts)[number] => Boolean(post))

const featured = [
  { label: "The path", path: "/posts/paths/", image: "/images/critical.png" },
  { label: "The danger", path: "/posts/is-sometime-now/", image: "/images/is-sometime-now.jpg" },
  { label: "The destination", path: "/posts/granny/", image: "/images/granny-family.jpg" },
]

const countryCount = new Set(locations.map((location) => location.title.split(",").at(-1)?.trim())).size
const countryProgress = ((countryCount / 195) * 100).toFixed(1)
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <div class="absolute inset-0 block dark:hidden">
    <div id="particles1" class="fixed inset-0"></div>
    <div id="particles2" class="fixed inset-0"></div>
    <div id="particles3" class="fixed inset-0"></div>
  </div>

  <script is:inline src="/js/bg.js"></script>

  <section id="orbit" class="orbit-section relative w-full">
    <div id="orbit-stage" class="sticky top-0 h-screen min-h-[680px] w-full overflow-hidden">
    <div id="galaxy" class="absolute inset-0 pointer-events-none hidden dark:block">
      <RealStarField />
      <MeteorShower />
    </div>

    <div class="absolute inset-0 z-20 pointer-events-none overflow-hidden">
      <IdentityComets />
    </div>

    <div id="planetcont" class="animate absolute inset-0 top-[28%] overflow-hidden">
      <div id="crescent" class="absolute top-0 left-1/2 -translate-x-1/2 w-[165vw] min-h-[100vh] aspect-square rounded-full p-px bg-gradient-to-b from-white/70 from-0% to-transparent to-[6%]">
        <div id="planet" class="relative w-full h-full bg-black rounded-full p-px overflow-hidden flex justify-center">
          <div class="earth-rotation" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
          <EarthGlobe />
          <div class="earth-shadow" aria-hidden="true"></div>
          <div id="blur" class="relative z-10 w-full h-20 rounded-full bg-violet-300/20 blur-3xl"></div>
        </div>
      </div>
    </div>

    <div id="orbit-copy" class="animate pointer-events-none absolute inset-0 z-30 flex items-center justify-center">
      <div class="relative px-5 text-center -translate-y-6">
        <p class="animated hero-kicker">Agent Architect</p>
        <h1 class="animated hero-name">Jordan Dotzel</h1>
        <div id="ctaButtons" class="animated pointer-events-auto flex flex-wrap gap-3 justify-center mt-8">
          <a href="/musings" class="hero-primary">Read the musings</a>
          <a href="/research" class="hero-secondary">View the research</a>
        </div>
      </div>
    </div>

    <div id="orbit-progress" class="orbit-progress" aria-label="Travel progress">
      <div class="orbit-progress-item">
        <div><span>Countries</span><strong>{countryProgress}%</strong></div>
        <div class="orbit-progress-track"><i style={`width:${countryProgress}%`}></i></div>
      </div>
      <div class="orbit-progress-item">
        <div><span>Planetary</span><strong>12.5%</strong></div>
        <div class="orbit-progress-track"><i style="width:12.5%"></i></div>
      </div>
      <div class="orbit-progress-item">
        <div>
          <span>Galactic</span>
          <div class="orbit-progress-value">
            <strong>≈ 0%</strong>
            <button id="globe-pause-button" type="button" aria-label="Pause Earth rotation" aria-pressed="false">
              <svg class="pause-icon" viewBox="0 0 12 12" aria-hidden="true">
                <rect x="2.25" y="1.5" width="2.5" height="9" rx="0.75"></rect>
                <rect x="7.25" y="1.5" width="2.5" height="9" rx="0.75"></rect>
              </svg>
              <svg class="play-icon" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M3 1.7 10 6 3 10.3V1.7Z"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="orbit-progress-track"><i style="width:0.15%"></i></div>
      </div>
    </div>

    <div id="orbit-prompt" class="absolute inset-x-0 bottom-7 z-30 flex justify-center text-xs uppercase tracking-[0.24em] text-white/45">
      Scroll to enter orbit
    </div>
    </div>
  </section>

  <div class="relative bg-black border-t border-white/10">
    <div class="mx-auto max-w-screen-md px-5 py-24 space-y-28">
      <section class="animate grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="section-number">01 / Now</p>
          <h2 class="section-title">The future is arriving unevenly.</h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-white/70">
          <p>We are currently within the most dynamic and exciting era of human discovery. The number of unanswered questions remains high, and the tools required to probe them are finally being built.</p>
          <p>General artificial intelligence now has most of its necessary ingredients. It may create the most incredible benefits across society while also becoming the most destabilizing and dangerous technology ever created.</p>
          <p class="text-white">The research decisions we make now will lead to a society that eventually flourishes, decays, or disappears.</p>
        </div>
      </section>

      <section class="animate">
        <div class="section-heading-row">
          <div>
            <p class="section-number">02 / Selected transmissions</p>
            <h2 class="section-title">Musings</h2>
          </div>
          <a class="section-link" href="/musings">All musings →</a>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {selected.map((post) => {
            const art = featured.find((item) => item.path === post.data.permalink)
            return (
              <a class="featured-card" href={post.data.permalink}>
                <div class="featured-image">
                  <img src={art?.image} alt="" loading="lazy" />
                </div>
                <div class="p-5">
                  <p class="text-xs uppercase tracking-[0.18em] text-violet-300/75">{art?.label}</p>
                  <h3 class="mt-2 text-lg font-semibold text-white">{post.data.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/55">{post.data.description}</p>
                </div>
              </a>
            )
          })}
        </div>
      </section>

      <section class="animate grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="section-number">03 / Research</p>
          <h2 class="section-title">Efficient intelligence.</h2>
        </div>
        <div>
          <p class="text-lg leading-relaxed text-white/70">My academic research focused on building more efficient deep learning systems through neural architecture design, low-precision quantization, and dynamic sparsity. The current work moves further up the stack: agents, thought traces, and the systems that will build whatever comes next.</p>
          <div class="mt-7 grid gap-3">
            <a class="signal-row" href="https://arxiv.org/abs/2308.03290" target="_blank">
              <span><b>FLIQS</b><small>Best Paper · AutoML 2024</small></span><span>↗</span>
            </a>
            <a class="signal-row" href="https://arxiv.org/abs/2405.03103" target="_blank">
              <span><b>Learning from Students</b><small>ICML 2024</small></span><span>↗</span>
            </a>
            <a class="signal-row" href="https://arxiv.org/abs/2404.04900" target="_blank">
              <span><b>Radial Networks</b><small>Dynamic routing for large language models</small></span><span>↗</span>
            </a>
          </div>
          <a class="section-link mt-6 inline-flex" href="/research">Research and experience →</a>
        </div>
      </section>

      <section class="animate">
        <div class="section-heading-row">
          <div>
            <p class="section-number">04 / Recent transmissions</p>
            <h2 class="section-title">Latest</h2>
          </div>
        </div>
        <ul class="mt-8 space-y-4">
          {posts.slice(0, 4).map((post) => <li><ArrowCard entry={post} /></li>)}
        </ul>
      </section>

      <section class="animate pb-8">
        <p class="section-number">05 / Signal</p>
        <h2 class="section-title">Find me in the noise.</h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {SOCIALS.map((social) => (
            <a href={social.HREF} target="_blank" class="signal-row">
              <span><b>{social.NAME}</b><small>{social.TEXT}</small></span><span>↗</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .orbit-section {
    height: 220vh;
    min-height: 1360px;
  }

  #orbit-stage { isolation: isolate; }

  #crescent {
    --orbit-scale: 1;
    --orbit-y: 0vh;
    transform: translateX(-50%) translateY(var(--orbit-y)) scale(var(--orbit-scale));
    transform-origin: 50% 0%;
    will-change: transform, opacity;
  }

  #orbit-copy,
  #orbit-progress,
  #orbit-prompt {
    will-change: opacity;
  }

  .hero-kicker { @apply text-xs md:text-sm font-semibold uppercase tracking-[0.24em] text-violet-200/70; }
  .hero-name { @apply mt-3 text-4xl md:text-6xl lg:text-7xl font-bold uppercase tracking-[0.04em] text-white; }
  .hero-primary { @apply rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black hover:bg-violet-100 transition-colors; }
  .hero-secondary { @apply rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors; }
  .orbit-progress { @apply pointer-events-none absolute bottom-16 left-1/2 z-30 grid w-[min(760px,calc(100%-2rem))] -translate-x-1/2 grid-cols-3 gap-2; }
  .orbit-progress-item { @apply rounded-xl border border-white/15 bg-black/35 px-3 py-2.5 backdrop-blur-md; }
  .orbit-progress-item > div:first-child { @apply flex items-center justify-between gap-2; }
  .orbit-progress-item span { @apply text-[10px] font-semibold uppercase tracking-[0.16em] text-white/50; }
  .orbit-progress-item strong { @apply text-xs font-semibold text-violet-100/85; }
  .orbit-progress-value { @apply flex items-center gap-1.5; }
  #globe-pause-button { @apply pointer-events-auto flex size-6 items-center justify-center rounded-full border border-white/15 text-white/55 transition-colors hover:border-violet-200/45 hover:bg-white/10 hover:text-white; }
  #globe-pause-button svg { @apply size-2.5 fill-current; }
  #globe-pause-button .play-icon { @apply hidden; }
  #globe-pause-button[data-paused="true"] .pause-icon { @apply hidden; }
  #globe-pause-button[data-paused="true"] .play-icon { @apply block; }
  .orbit-progress-track { @apply mt-2 h-px overflow-hidden rounded-full bg-white/15; }
  .orbit-progress-track i { @apply block h-full rounded-full bg-gradient-to-r from-violet-400 to-cyan-300; }
  .section-number { @apply text-xs font-semibold uppercase tracking-[0.2em] text-violet-300/65; }
  .section-title { @apply mt-2 text-2xl md:text-3xl font-semibold text-white; }
  .section-heading-row { @apply flex flex-wrap items-end justify-between gap-5; }
  .section-link { @apply text-sm text-white/60 underline decoration-white/20 underline-offset-4 hover:text-white hover:decoration-white/60 transition-colors; }
  .featured-card { @apply overflow-hidden rounded-2xl border border-white/15 bg-white/[0.035] hover:-translate-y-1 hover:border-violet-300/40 hover:bg-white/[0.06] transition-all duration-300; }
  .featured-image { @apply aspect-[4/3] overflow-hidden border-b border-white/10 bg-white/5; }
  .featured-image img { @apply h-full w-full object-cover opacity-80 grayscale-[15%] transition duration-500; }
  .featured-card:hover img { @apply opacity-100 scale-[1.03] grayscale-0; }
  .signal-row { @apply flex items-center justify-between rounded-xl border border-white/15 bg-white/[0.025] px-4 py-3 text-white/65 hover:border-violet-300/40 hover:bg-white/[0.06] hover:text-white transition-colors; }
  .signal-row span:first-child { @apply flex min-w-0 flex-col; }
  .signal-row b { @apply truncate text-sm font-semibold text-white; }
  .signal-row small { @apply truncate text-xs text-white/45; }

  .earth-rotation {
    @apply absolute inset-0 flex;
    width: 200%;
    opacity: 0.72;
    filter: saturate(0.7) brightness(0.7) contrast(1.18);
    animation: earth-rotation 138.462s linear infinite reverse;
    will-change: transform;
    transition: opacity 900ms ease;
  }

  .globe-ready .earth-rotation { opacity: 0; }

  .earth-rotation span {
    width: 50%;
    height: 100%;
    flex: none;
    background-image: url('/images/earth-night-nasa-8k.webp');
    background-position: center top;
    background-repeat: no-repeat;
    background-size: 100% auto;
  }

  .earth-shadow {
    @apply absolute inset-0;
    background:
      radial-gradient(ellipse at 50% 0%, rgb(0 0 0 / 0.01) 0%, rgb(0 0 0 / 0.06) 34%, rgb(0 0 0 / 0.48) 74%),
      linear-gradient(to bottom, rgb(2 6 23 / 0.03), #000 91%);
  }

  @keyframes earth-rotation {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .earth-rotation { animation: none; }
  }

  @media (max-width: 640px) {
    .orbit-section {
      height: 200vh;
      min-height: 1360px;
    }
    .orbit-progress { @apply gap-1.5; }
    .orbit-progress-item { @apply px-2 py-2; }
    .orbit-progress-item span { @apply text-[8px] tracking-[0.1em]; }
    .orbit-progress-item strong { @apply text-[10px]; }
  }
</style>

<script>
  const initializeOrbitSequence = () => {
    const section = document.getElementById("orbit")
    const crescent = document.getElementById("crescent")
    const copy = document.getElementById("orbit-copy")
    const progressDisplay = document.getElementById("orbit-progress")
    const prompt = document.getElementById("orbit-prompt")
    const markerCanvas = document.getElementById("earth-markers") as HTMLCanvasElement | null
    const pauseButton = document.getElementById("globe-pause-button") as HTMLButtonElement | null
    if (!section || !crescent || !copy || !progressDisplay || !prompt) return

    const orbitWindow = window as Window & { __orbitCleanup?: () => void }
    orbitWindow.__orbitCleanup?.()

    let frame = 0
    const clamp = (value: number, minimum = 0, maximum = 1) => Math.min(maximum, Math.max(minimum, value))
    const fadeBetween = (progress: number, start: number, end: number) => 1 - clamp((progress - start) / (end - start))

    const render = () => {
      frame = 0
      const sectionTop = section.getBoundingClientRect().top + window.scrollY
      const travel = Math.max(1, section.offsetHeight - window.innerHeight)
      const progress = clamp((window.scrollY - sectionTop) / travel)
      const eased = progress * progress * (3 - 2 * progress)
      const scale = Math.pow(0.022, eased)
      const earthOpacity = fadeBetween(progress, 0.78, 0.97)
      const copyOpacity = fadeBetween(progress, 0.04, 0.31)
      const hudOpacity = fadeBetween(progress, 0.12, 0.43)
      const promptOpacity = fadeBetween(progress, 0, 0.13)

      crescent.style.setProperty("--orbit-scale", scale.toFixed(4))
      crescent.style.setProperty("--orbit-y", `${(eased * 14).toFixed(2)}vh`)
      crescent.style.opacity = earthOpacity.toFixed(3)
      copy.style.opacity = copyOpacity.toFixed(3)
      progressDisplay.style.opacity = hudOpacity.toFixed(3)
      prompt.style.opacity = promptOpacity.toFixed(3)
      copy.style.visibility = copyOpacity < 0.015 ? "hidden" : "visible"
      progressDisplay.style.visibility = hudOpacity < 0.015 ? "hidden" : "visible"
      prompt.style.visibility = promptOpacity < 0.015 ? "hidden" : "visible"
      if (markerCanvas) markerCanvas.style.pointerEvents = progress > 0.12 ? "none" : ""
      if (pauseButton) pauseButton.style.pointerEvents = hudOpacity < 0.15 ? "none" : ""
    }

    const scheduleRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render)
    }

    window.addEventListener("scroll", scheduleRender, { passive: true })
    window.addEventListener("resize", scheduleRender, { passive: true })
    orbitWindow.__orbitCleanup = () => {
      window.removeEventListener("scroll", scheduleRender)
      window.removeEventListener("resize", scheduleRender)
      if (frame) window.cancelAnimationFrame(frame)
    }
    render()
  }

  document.addEventListener("astro:after-swap", initializeOrbitSequence)
  initializeOrbitSequence()
</script>
