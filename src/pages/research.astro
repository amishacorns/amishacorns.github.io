---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { publications } from "../data/publications"

const experience = [
  ["Gemini + Cloud, Advanced Development Team", "Neural Architect", "July 2025 — Present"],
  ["Google, TPU Performance Team", "Student Researcher", "June 2024 — June 2025"],
  ["Google, Platforms-Aware AutoML", "Student Researcher", "June 2022 — May 2024"],
  ["Computer Systems Laboratory, Cornell", "PhD Candidate", "August 2019 — June 2025"],
  ["Datto", "Software Engineer", "June 2017 — June 2018"],
]

---

<PageLayout title="Research" description="Research on efficient neural systems, agents, and the path to AGI.">
  <TopLayout>
    <div class="animate max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-300/65">Architecture · Efficiency · Agents</p>
      <h1 class="mt-3 text-4xl font-semibold text-white">Research</h1>
      <p class="research-summary mt-4 text-lg leading-relaxed text-white/55">
        I received my PhD from the <a href="https://www.csl.cornell.edu/">Computer Systems Laboratory</a> at Cornell University, under the supervision of <a href="https://www.csl.cornell.edu/~zhiruz/index.html">Prof. Zhiru Zhang</a> and co-advised by <a href="https://www.mohsaied.com/">Mohamed Abdelfattah</a>. I previously studied a combination of Physics and Computer Science in the College of Arts and Sciences at Cornell University. My academic research focused on building more efficient deep learning systems through efficient neural architectures, low-precision quantization, and dynamic sparsity. My current research focuses on agentic systems, neural architectures, the physics of consciousness, computational morality, and artificial general intelligence.
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="space-y-24">
      <section class="animate">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow">01 / Trajectory</p>
            <h2>Experience</h2>
          </div>
        </div>
        <ol class="mt-7 border-l border-white/15 pl-6">
          {experience.map(([company, role, date]) => (
            <li class="timeline-item">
              <p>{date}</p><h3>{company}</h3><span>{role}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="animate">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div><p class="eyebrow">02 / Papers</p><h2>Publications</h2></div>
          <a class="scholar" href="https://scholar.google.com/citations?user=5H-MYAoAAAAJ" target="_blank">View Google Scholar ↗</a>
        </div>
        <ol class="mt-7 divide-y divide-white/10 border-y border-white/10">
          {publications.map((paper, index) => (
            <li>
              <a class="paper" href={paper.href} target="_blank">
                <span class="paper-number">{String(index + 1).padStart(2, "0")}</span>
                <span>
                  <b>{paper.title}</b>
                  <small class="paper-authors">{paper.authors}</small>
                  <small class="paper-venue">{paper.venue}</small>
                </span>
                <span>↗</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="contribution-note">* Equal contribution</p>
      </section>
    </div>
  </BottomLayout>
</PageLayout>

<style>
  .eyebrow { @apply text-xs font-semibold uppercase tracking-[0.2em] text-violet-300/65; }
  .research-summary a { @apply text-white/75 underline decoration-white/20 underline-offset-4 transition-colors hover:text-white hover:decoration-white/55; }
  h2 { @apply mt-2 text-2xl font-semibold text-white; }
  .timeline-item { @apply relative pb-8 last:pb-0; }
  .timeline-item::before { content: ""; @apply absolute -left-[1.74rem] top-1 h-2.5 w-2.5 rounded-full border border-violet-200/60 bg-black; }
  .timeline-item p { @apply text-xs uppercase tracking-wider text-white/35; }
  .timeline-item h3 { @apply mt-1 text-base font-semibold text-white; }
  .timeline-item span { @apply text-sm text-white/50; }
  .scholar { @apply inline-flex rounded-full border border-violet-200/25 bg-violet-300/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-violet-100/75 transition-colors hover:border-violet-200/50 hover:bg-violet-300/10 hover:text-white; }
  .paper { @apply grid grid-cols-[2rem_1fr_auto] gap-3 py-5 text-white/50 hover:text-white transition-colors; }
  .paper-number { @apply text-xs text-violet-300/55; }
  .paper b { @apply block leading-snug text-white; }
  .paper-authors { @apply mt-2 block text-sm normal-case tracking-normal text-white/50; }
  .paper-venue { @apply mt-1 block text-xs uppercase tracking-wider text-white/35; }
  .contribution-note { @apply mt-4 text-xs text-white/35; }
</style>
