---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
---

<PageLayout title="Signal Lost" description="The requested page could not be found.">
  <section class="flex min-h-screen items-center py-28">
    <Container size="md">
      <div class="animate mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-violet-300/65">404 / Signal Lost</p>
        <h1 class="mt-5 text-5xl font-semibold text-white md:text-7xl">This transmission drifted out of range.</h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-white/55">The page may have moved, disappeared, or never existed in this branch of the timeline.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a class="primary-link" href="/">Return to Earth</a>
          <a class="secondary-link" href="/transmissions">Browse Transmissions</a>
          <a class="secondary-link" href="/search">Search the Archive</a>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>

<style>
  .primary-link { @apply rounded-full bg-white px-5 py-2.5 font-semibold text-black transition-colors hover:bg-violet-100; }
  .secondary-link { @apply rounded-full border border-white/20 px-5 py-2.5 font-semibold text-white/75 transition-colors hover:border-violet-200/50 hover:bg-white/10 hover:text-white; }
</style>
