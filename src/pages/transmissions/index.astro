---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { BLOG } from "@consts"
import { formatDate } from "@lib/utils"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({ ...post, tags: [...new Set(post.data.tags.map((tag) => tag.toLowerCase()))] }))
const availableTags = [...new Set([...posts.flatMap((post) => post.tags), "health", "ethics"])]
  .sort((a, b) => a.localeCompare(b))
  .map((tag) => ({ tag, count: posts.filter((post) => post.tags.includes(tag)).length }))
const tagLabel = (tag: string) => tag.split(" ").map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ")
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <TopLayout>
    <h1 class="animate text-4xl font-semibold text-white">Transmissions</h1>
  </TopLayout>
  <BottomLayout>
    <div class="animate" data-archive>
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3" data-controls hidden>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by tag">
          <button type="button" class="tag-filter" data-tag="" data-label="All" aria-pressed="true" aria-controls="transmission-results">
            All <span class="tag-count">{posts.length}</span>
          </button>
          {availableTags.map(({ tag, count }) => (
            <button type="button" class="tag-filter" data-tag={tag} data-label={tagLabel(tag)} aria-pressed="false" aria-controls="transmission-results">
              {tagLabel(tag)} <span class="tag-count">{count}</span>
            </button>
          ))}
        </div>
        <p class="sr-only" data-status role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
      <div id="transmission-results" class="grid gap-5 md:grid-cols-2">
        {posts.map((post, index) => (
          <a
            class:list={["transmission-card", index === 0 && "is-featured"]}
            href={post.data.permalink}
            data-post
            data-tags={JSON.stringify(post.tags)}
          >
            {post.data.header?.teaser && (
              <div class="transmission-image">
                <img src={"/images/" + post.data.header.teaser} alt="" loading="lazy" />
              </div>
            )}
            <div class="p-5 md:p-6 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.12em] text-white/40">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <span>·</span>
                  <span>{post.tags.map(tagLabel).join(" · ")}</span>
                </div>
                <h2 class="mt-3 text-xl font-semibold text-white">{post.data.title}</h2>
                <p class="mt-3 leading-relaxed text-white/55">{post.data.description}</p>
              </div>
              <span class="mt-6 text-sm text-violet-200/70" aria-hidden="true">Read transmission →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="rounded-2xl border border-white/15 px-6 py-12 text-center" data-empty hidden>
        <p class="text-white/65">No published transmissions with this tag yet.</p>
        <button class="mt-4 text-sm text-violet-200 underline underline-offset-4" type="button" data-reset>Show all transmissions</button>
      </div>
    </div>
  </BottomLayout>
</PageLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-archive]")!
  const controls = root.querySelector<HTMLElement>("[data-controls]")!
  const status = root.querySelector<HTMLElement>("[data-status]")!
  const empty = root.querySelector<HTMLElement>("[data-empty]")!
  const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tag]"))
  const items = Array.from(root.querySelectorAll<HTMLElement>("[data-post]")).map((element) => ({
    element,
    tags: JSON.parse(element.dataset.tags!) as string[],
  }))
  let tag = ""

  const filterURL = () => {
    const url = new URL(window.location.href)
    if (tag) url.searchParams.set("tag", tag)
    else url.searchParams.delete("tag")
    url.searchParams.delete("topic")
    url.searchParams.delete("q")
    return url
  }

  const render = () => {
    let count = 0
    for (const item of items) {
      const matches = !tag || item.tags.includes(tag)
      item.element.hidden = !matches
      item.element.classList.toggle("is-featured", matches && count === 0)
      if (matches) count++
    }
    for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.tag === tag))
    const label = buttons.find((button) => button.dataset.tag === tag)!.dataset.label
    status.textContent = count + " transmission" + (count === 1 ? "" : "s") + (tag ? " · " + label : "")
    empty.hidden = count > 0
  }

  const readURL = () => {
    const params = new URLSearchParams(window.location.search)
    let requestedTag = (params.get("tag") ?? params.get("topic") ?? "").toLowerCase()
    if (requestedTag === "ai") requestedTag = "artificial intelligence"
    tag = buttons.some((button) => button.dataset.tag === requestedTag) ? requestedTag : ""
    const url = filterURL()
    if (url.href !== window.location.href) history.replaceState(null, "", url)
    render()
  }

  const selectTag = (selected: string) => {
    tag = selected
    const url = filterURL()
    if (url.href !== window.location.href) history.pushState(null, "", url)
    render()
  }
  buttons.forEach((button) => button.addEventListener("click", () => selectTag(button.dataset.tag!)))
  root.querySelector("[data-reset]")!.addEventListener("click", () => {
    selectTag("")
    buttons[0].focus()
  })
  window.addEventListener("popstate", readURL)
  readURL()
  controls.hidden = false
</script>

<style>
  [hidden] { display: none !important; }
  .tag-filter { @apply inline-flex min-h-7 items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.025] px-2.5 py-1 text-xs leading-4 text-white/65 transition-colors hover:border-violet-200/40 hover:text-white; }
  .tag-filter[aria-pressed="true"] { @apply border-violet-300/60 bg-violet-300/15 text-violet-100; }
  .tag-count { @apply text-[10px] leading-none opacity-60; }
  .transmission-card { @apply relative overflow-hidden rounded-2xl border border-white/15 bg-white/[0.025] hover:-translate-y-1 hover:border-violet-300/40 hover:bg-white/[0.055] transition-all duration-300; }
  .transmission-card.is-featured { @apply md:col-span-2 md:grid md:grid-cols-2; }
  .transmission-card.is-featured h2 { @apply text-2xl; }
  .transmission-image { @apply aspect-[16/10] overflow-hidden border-b border-white/10 bg-white/5; }
  .is-featured .transmission-image { @apply md:aspect-[16/9]; }
  .transmission-image img { @apply h-full w-full object-cover opacity-75 grayscale-[10%] transition duration-500; }
  .transmission-card:hover img { @apply scale-[1.025] opacity-100 grayscale-0; }
  button:focus-visible, .transmission-card:focus-visible { @apply outline outline-2 outline-offset-4 outline-violet-200; }
  @media (prefers-reduced-motion: reduce) {
    .transmission-card, .transmission-image img { transition: none; transform: none; }
  }
</style>
