<script>
  const initializeOrbitalFocus = () => {
    const stage = document.getElementById("orbit-stage")
    if (!stage) return
    const focusWindow = window as Window & { __orbitalFocusCleanup?: () => void }
    focusWindow.__orbitalFocusCleanup?.()
    let activeTarget = ""
    let returnTimer = 0

    const setFocus = (event: Event) => {
      const target = (event as CustomEvent<{ target?: string }>).detail?.target ?? ""
      if (!target) return
      window.clearTimeout(returnTimer)
      stage.classList.remove("orbital-returning")
      if (activeTarget && activeTarget !== target) {
        window.dispatchEvent(new CustomEvent("orbital:clear-focus"))
      }
      activeTarget = target
      stage.dataset.orbitalFocus = target
    }

    const clearFocus = () => {
      if (!activeTarget) return
      activeTarget = ""
      stage.classList.add("orbital-returning")
      delete stage.dataset.orbitalFocus
      window.dispatchEvent(new CustomEvent("orbital:clear-focus"))
      window.dispatchEvent(new CustomEvent("globe:set-paused", { detail: { paused: false } }))
      window.clearTimeout(returnTimer)
      returnTimer = window.setTimeout(() => stage.classList.remove("orbital-returning"), 760)
    }

    const pointerHandler = (event: PointerEvent) => {
      if (!activeTarget) return
      const target = event.target
      if (target instanceof Element && target.closest("[data-focus-agi], [data-focus-singularity], .inbound-agi-object")) return
      clearFocus()
    }

    const keyHandler = () => clearFocus()
    const scrollHandler = () => clearFocus()
    window.addEventListener("orbital:focus-mode", setFocus)
    window.addEventListener("wheel", scrollHandler, { passive: true })
    window.addEventListener("scroll", scrollHandler, { passive: true })
    window.addEventListener("touchstart", scrollHandler, { passive: true })
    window.addEventListener("keydown", keyHandler)
    document.addEventListener("pointerdown", pointerHandler, true)

    focusWindow.__orbitalFocusCleanup = () => {
      window.clearTimeout(returnTimer)
      stage.classList.remove("orbital-returning")
      window.removeEventListener("orbital:focus-mode", setFocus)
      window.removeEventListener("wheel", scrollHandler)
      window.removeEventListener("scroll", scrollHandler)
      window.removeEventListener("touchstart", scrollHandler)
      window.removeEventListener("keydown", keyHandler)
      document.removeEventListener("pointerdown", pointerHandler, true)
    }
  }

  document.addEventListener("astro:after-swap", initializeOrbitalFocus)
  initializeOrbitalFocus()
</script>
