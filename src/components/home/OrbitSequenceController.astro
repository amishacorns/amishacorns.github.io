<script>
  const initializeOrbitSequence = () => {
    const section = document.getElementById("orbit")
    const stage = document.getElementById("orbit-stage")
    const planetContainer = document.getElementById("planetcont")
    const crescent = document.getElementById("crescent")
    const copy = document.getElementById("orbit-copy")
    const progressDisplay = document.getElementById("orbit-progress")
    const prompt = document.getElementById("orbit-prompt")
    const singularity = document.getElementById("deep-singularity")
    const markerCanvas = document.getElementById("earth-markers") as HTMLCanvasElement | null
    const orbitingObjects = document.getElementById("orbiting-objects")
    const pauseButton = document.getElementById("globe-pause-button") as HTMLButtonElement | null
    const singularitySystem = singularity?.querySelector<HTMLElement>(".singularity-system")
    if (!section || !stage || !planetContainer || !crescent || !copy || !progressDisplay || !prompt) return

    const orbitWindow = window as Window & { __orbitCleanup?: () => void }
    orbitWindow.__orbitCleanup?.()

    let frame = 0
    let measureFrame = 0
    let scrollIdleTimer = 0
    let sectionTop = 0
    let travel = 1
    let earthBaseCenterX = 0
    let earthBaseTop = 0
    let earthHeight = 1
    let singularityCenterX = 0
    let singularityCenterY = 0
    let viewportCenterY = 0
    let targetProgress = 0
    let renderedProgress = 0
    let scrolling = false
    let copyVisible = true
    let hudVisible = true
    let promptVisible = true
    let markersInteractive = true
    let markersVisible = true
    let pauseInteractive = true
    let orbitingObjectsVisible = true
    let singularityActive = false
    ;(window as Window & { __orbitObjectsVisible?: boolean }).__orbitObjectsVisible = true
    const clamp = (value: number, minimum = 0, maximum = 1) => Math.min(maximum, Math.max(minimum, value))
    const fadeBetween = (progress: number, start: number, end: number) => 1 - clamp((progress - start) / (end - start))

    const readProgress = () => clamp((window.scrollY - sectionTop) / travel)

    const measure = () => {
      measureFrame = 0
      const sectionBounds = section.getBoundingClientRect()
      const stageBounds = stage.getBoundingClientRect()
      const singularityBounds = singularitySystem?.getBoundingClientRect()
      sectionTop = sectionBounds.top + window.scrollY
      travel = Math.max(1, section.offsetHeight - window.innerHeight)
      earthBaseCenterX = stage.clientWidth / 2
      earthBaseTop = planetContainer.offsetTop + crescent.offsetTop
      earthHeight = crescent.offsetHeight
      singularityCenterX = singularityBounds
        ? singularityBounds.left + singularityBounds.width / 2 - stageBounds.left
        : stage.clientWidth * 0.72
      singularityCenterY = singularityBounds
        ? singularityBounds.top + singularityBounds.height / 2 - stageBounds.top
        : stage.clientHeight * 0.42
      viewportCenterY = stage.clientHeight * 0.52
      targetProgress = readProgress()
      if (!frame) frame = window.requestAnimationFrame(render)
    }

    const setScrolling = (active: boolean) => {
      if (scrolling === active) return
      scrolling = active
      stage.classList.toggle("orbit-scrolling", scrolling)
      window.dispatchEvent(new CustomEvent("orbit:scroll-state", { detail: { scrolling } }))
    }

    const finishScrolling = () => {
      scrollIdleTimer = 0
      setScrolling(false)
    }

    const render = () => {
      frame = 0
      targetProgress = readProgress()
      const distance = targetProgress - renderedProgress
      renderedProgress = Math.abs(distance) < 0.0005
        ? targetProgress
        : renderedProgress + distance * 0.42
      const progress = renderedProgress
      const eased = progress * progress * (3 - 2 * progress)
      const scale = Math.pow(0.022, eased)
      const earthOpacity = fadeBetween(progress, 0.68, 0.84)
      const copyOpacity = fadeBetween(progress, 0.04, 0.31)
      const hudOpacity = fadeBetween(progress, 0.82, 0.98)
      const promptOpacity = fadeBetween(progress, 0, 0.13)
      const orbitingObjectsOpacity = fadeBetween(progress, 0.04, 0.2)
      const singularityReveal = clamp((progress - 0.42) / 0.38)
      const singularityScale = 0.72 + singularityReveal * 0.3
      const singularityJourney = clamp((progress - 0.28) / 0.5)
      const singularityEase = singularityJourney * singularityJourney * (3 - 2 * singularityJourney)
      const centeringJourney = clamp(progress / 0.22)
      const centeringEase = centeringJourney * centeringJourney * (3 - 2 * centeringJourney)

      const desiredEarthCenterX = earthBaseCenterX + (singularityCenterX - earthBaseCenterX) * singularityEase
      const initialEarthCenterY = earthBaseTop + earthHeight / 2
      const centeredEarthY = Math.min(initialEarthCenterY, viewportCenterY)
      const preSingularityCenterY = initialEarthCenterY + (centeredEarthY - initialEarthCenterY) * centeringEase
      const desiredEarthCenterY = preSingularityCenterY + (singularityCenterY - preSingularityCenterY) * singularityEase
      const orbitX = desiredEarthCenterX - earthBaseCenterX
      const orbitY = desiredEarthCenterY - (earthBaseTop + earthHeight * scale / 2)

      crescent.style.transform = `translate3d(calc(-50% + ${orbitX.toFixed(2)}px), ${orbitY.toFixed(2)}px, 0) scale(${scale.toFixed(4)})`
      crescent.style.opacity = earthOpacity.toFixed(3)
      if (orbitingObjects) orbitingObjects.style.opacity = orbitingObjectsOpacity.toFixed(3)
      copy.style.opacity = copyOpacity.toFixed(3)
      progressDisplay.style.opacity = hudOpacity.toFixed(3)
      prompt.style.opacity = promptOpacity.toFixed(3)
      if (singularity) {
        singularity.style.setProperty("--singularity-reveal", singularityReveal.toFixed(3))
        singularity.style.setProperty("--singularity-scale", singularityScale.toFixed(3))
        const nextSingularityActive = singularityReveal >= 0.02
        if (nextSingularityActive !== singularityActive) {
          singularityActive = nextSingularityActive
          singularity.classList.toggle("singularity-active", singularityActive)
        }
      }
      ;(window as Window & { __singularityReveal?: number }).__singularityReveal = singularityReveal
      const nextCopyVisible = copyOpacity >= 0.015
      const nextHudVisible = hudOpacity >= 0.015
      const nextPromptVisible = promptOpacity >= 0.015
      const nextMarkersInteractive = earthOpacity >= 0.15
      const nextMarkersVisible = progress < 0.34
      const nextPauseInteractive = hudOpacity >= 0.15
      const nextOrbitingObjectsVisible = orbitingObjectsOpacity >= 0.015
      if (nextCopyVisible !== copyVisible) {
        copyVisible = nextCopyVisible
        copy.style.visibility = copyVisible ? "visible" : "hidden"
      }
      if (nextHudVisible !== hudVisible) {
        hudVisible = nextHudVisible
        progressDisplay.style.visibility = hudVisible ? "visible" : "hidden"
      }
      if (nextPromptVisible !== promptVisible) {
        promptVisible = nextPromptVisible
        prompt.style.visibility = promptVisible ? "visible" : "hidden"
      }
      if (markerCanvas && nextMarkersInteractive !== markersInteractive) {
        markersInteractive = nextMarkersInteractive
        markerCanvas.style.pointerEvents = markersInteractive ? "" : "none"
      }
      if (markerCanvas && nextMarkersVisible !== markersVisible) {
        markersVisible = nextMarkersVisible
        markerCanvas.style.visibility = markersVisible ? "visible" : "hidden"
      }
      if (pauseButton && nextPauseInteractive !== pauseInteractive) {
        pauseInteractive = nextPauseInteractive
        pauseButton.style.pointerEvents = pauseInteractive ? "" : "none"
      }
      if (orbitingObjects && nextOrbitingObjectsVisible !== orbitingObjectsVisible) {
        orbitingObjectsVisible = nextOrbitingObjectsVisible
        orbitingObjects.style.visibility = orbitingObjectsVisible ? "visible" : "hidden"
        ;(window as Window & { __orbitObjectsVisible?: boolean }).__orbitObjectsVisible = orbitingObjectsVisible
      }

      if (Math.abs(targetProgress - renderedProgress) >= 0.0005) {
        frame = window.requestAnimationFrame(render)
      }
    }

    const scheduleRender = () => {
      targetProgress = readProgress()
      setScrolling(true)
      window.clearTimeout(scrollIdleTimer)
      scrollIdleTimer = window.setTimeout(finishScrolling, 140)
      if (!frame) frame = window.requestAnimationFrame(render)
    }

    const scheduleMeasure = () => {
      if (measureFrame) return
      measureFrame = window.requestAnimationFrame(measure)
    }

    window.addEventListener("scroll", scheduleRender, { passive: true })
    window.addEventListener("resize", scheduleMeasure, { passive: true })
    orbitWindow.__orbitCleanup = () => {
      window.removeEventListener("scroll", scheduleRender)
      window.removeEventListener("resize", scheduleMeasure)
      window.clearTimeout(scrollIdleTimer)
      if (frame) window.cancelAnimationFrame(frame)
      if (measureFrame) window.cancelAnimationFrame(measureFrame)
      setScrolling(false)
    }
    measure()
    renderedProgress = targetProgress
    render()
  }

  document.addEventListener("astro:after-swap", initializeOrbitSequence)
  initializeOrbitSequence()
</script>
