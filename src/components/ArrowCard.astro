---
import type { CollectionEntry } from "astro:content"
import { formatDate } from "@lib/utils"

interface Props {
  entry: CollectionEntry<"blog">
}

const { entry } = Astro.props
---

<div class="group relative flex items-center gap-3 rounded-lg border border-white/20 p-4 transition-colors duration-300 ease-in-out hover:bg-white/10">
  <div class="w-full blend group-hover:text-white">
    <div class="flex flex-wrap items-center gap-2">
      <time class="text-sm uppercase" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      {entry.data.tags.length > 0 && <><span aria-hidden="true">·</span><span class="text-xs uppercase text-white/55">{entry.data.tags.join(" · ")}</span></>}
    </div>
    <h3 class="mt-3 font-semibold text-white"><a href={entry.data.permalink} class="card-link"><span class="line-clamp-2">{entry.data.title}</span></a></h3>
    <div class="line-clamp-2 text-sm">{entry.data.description}</div>
  </div>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-white" aria-hidden="true" focusable="false">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100"></line>
    <polyline points="12 5 19 12 12 19" class="translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1"></polyline>
  </svg>
</div>

<style>
  .card-link::after { content: ""; @apply absolute inset-0 rounded-lg; }
  .card-link:focus-visible { outline: none; }
  .card-link:focus-visible::after { @apply outline outline-2 outline-offset-2 outline-violet-300; }
</style>
