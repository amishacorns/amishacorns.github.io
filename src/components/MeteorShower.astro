---
/**
 * Meteors.astro
 * This component creates meteors that are appended to the galaxy on interval.
 * Meteors are removed from the document after the animation is completed.
 * There are four (4) meteor shower containers, one for each diagonal direction.
 */
---

<div id="meteors">
  <div class="shower ur" />
  <div class="shower dr" />
  <div class="shower dl" />
  <div class="shower ul" />
</div>

<script>
  const initializeMeteorShower = () => {
    const root = document.getElementById("meteors")
    if (!root) return
    const showers = root.querySelectorAll<HTMLElement>(".shower")
    if (showers.length === 0) return
    type MeteorLife = { remaining: number; started: number; timer: number }
    const active = new Map<HTMLElement, MeteorLife>()
    let paused = false
    let orbitVisible = true

    const scheduleRemoval = (meteor: HTMLElement, life: MeteorLife) => {
      life.started = performance.now()
      life.timer = window.setTimeout(() => {
        active.delete(meteor)
        meteor.remove()
      }, life.remaining)
    }

    const createMeteor = () => {
      if (paused || !orbitVisible || document.hidden) return
      const meteor = document.createElement("div")
      meteor.className = "meteor"
      meteor.style.left = `${Math.round(Math.random() * window.innerWidth)}px`
      meteor.style.top = `${Math.round(Math.random() * window.innerHeight)}px`
      showers[Math.floor(Math.random() * showers.length)].append(meteor)
      const life: MeteorLife = { remaining: 3500, started: performance.now(), timer: 0 }
      active.set(meteor, life)
      scheduleRemoval(meteor, life)
    }

    const clearMeteors = () => {
      active.forEach((life, meteor) => {
        window.clearTimeout(life.timer)
        meteor.remove()
      })
      active.clear()
    }

    let interval = 0
    const stopMeteorLoop = () => {
      if (!interval) return
      window.clearInterval(interval)
      interval = 0
    }
    const startMeteorLoop = () => {
      if (interval || document.hidden || !orbitVisible) return
      interval = window.setInterval(createMeteor, 1500)
    }

    const pauseHandler = (event: Event) => {
      const focusActive = document.getElementById("orbit-stage")?.hasAttribute("data-orbital-focus") ?? false
      const requestedPause = (event as CustomEvent<{ paused?: boolean }>).detail?.paused ?? true
      const nextPaused = requestedPause && !focusActive
      if (nextPaused === paused) return
      paused = nextPaused
      root.classList.toggle("meteors-paused", paused)
      const now = performance.now()
      active.forEach((life, meteor) => {
        if (paused) {
          window.clearTimeout(life.timer)
          life.remaining = Math.max(0, life.remaining - (now - life.started))
        } else {
          scheduleRemoval(meteor, life)
        }
      })
    }

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      orbitVisible = entry?.isIntersecting ?? true
      if (orbitVisible) startMeteorLoop()
      else {
        stopMeteorLoop()
        clearMeteors()
      }
    }, { threshold: 0.01 })
    visibilityObserver.observe(root.closest("#orbit") ?? root)
    const pageVisibilityHandler = () => {
      if (document.hidden) {
        stopMeteorLoop()
        clearMeteors()
      } else {
        startMeteorLoop()
      }
    }
    document.addEventListener("visibilitychange", pageVisibilityHandler)
    window.addEventListener("globe:pause-state", pauseHandler)
    startMeteorLoop()
  }

  initializeMeteorShower()
</script>
