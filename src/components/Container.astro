---
type Props = {
  size: "sm" | "md" | "lg" | "xl" | "2xl"
}

const { size } = Astro.props
const widths = {
  sm: "max-w-screen-sm",
  md: "max-w-screen-md",
  lg: "max-w-screen-lg",
  xl: "max-w-screen-xl",
  "2xl": "max-w-screen-2xl",
}
---

<div class:list={["mx-auto h-full w-full px-5", widths[size]]}>
  <slot/>
</div>
