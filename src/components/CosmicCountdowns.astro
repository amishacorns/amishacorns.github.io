<div id="cosmic-events" class="cosmic-events">
  <div class="agi-impact-event">
    <button type="button" class="cosmic-readout impact-readout" data-focus-agi aria-label="Focus superintelligence">
      <span>Superintelligence</span>
      <strong data-countdown="agi">---D --:--:--</strong>
      <small>Estimated Arrival · 01 Oct 2027</small>
    </button>
  </div>

  <div class="singularity-event">
    <button type="button" class="cosmic-readout singularity-readout" data-focus-singularity aria-label="Focus the singularity">
      <span>Time To Singularity</span>
      <strong data-countdown="singularity">---D --:--:--</strong>
      <small>Event Horizon · 01 Jan 2050</small>
    </button>
  </div>
</div>

<style>
  .cosmic-events { @apply pointer-events-none absolute inset-0 z-[9] overflow-hidden; }

  .agi-impact-event { @apply absolute left-[3%] top-[8%] h-20 w-[17rem]; }

  .singularity-event { @apply absolute right-[3%] top-[8%] h-20 w-[17rem]; }

  .cosmic-readout {
    @apply absolute rounded-xl border border-white/10 bg-black/55 px-4 py-3 font-mono backdrop-blur-md;
    min-width: 17rem;
    color: inherit;
    text-align: left;
    min-height: 5.25rem;
  }
  .impact-readout { @apply pointer-events-auto left-0 top-0 cursor-crosshair transition hover:border-orange-200/35 hover:bg-orange-950/25; }
  .singularity-readout { @apply pointer-events-auto right-0 top-0 cursor-crosshair transition hover:border-orange-200/35 hover:bg-orange-950/25; }
  .cosmic-readout span { @apply block text-[10px] font-semibold uppercase tracking-[0.19em] text-white/40; }
  .cosmic-readout strong { @apply mt-0.5 block text-[16px] tracking-[0.08em] text-cyan-100/85; }
  .impact-readout strong { @apply text-orange-100/90; }
  .cosmic-readout small { @apply mt-0.5 block text-[10px] uppercase tracking-[0.1em] text-white/25; }

  @media (max-width: 800px) {
    .agi-impact-event { @apply left-3 top-[12%] scale-75 origin-top-left; }
    .singularity-event { @apply right-2 top-[12%] scale-75 origin-top-right; }
  }

  @media (max-width: 640px) {
    .agi-impact-event { @apply left-2 top-[12%] h-auto w-44 scale-100; }
    .singularity-event { @apply right-2 top-[12%] h-auto w-44 scale-100; }
    .cosmic-readout { @apply w-44 px-2.5 py-2; min-width: 0; }
    .cosmic-readout span { @apply text-[7px] tracking-[0.12em]; }
    .cosmic-readout strong { @apply text-[12px] tracking-[0.05em]; }
    .cosmic-readout small { @apply text-[7px] tracking-[0.04em]; }
  }
</style>

<script>
  const initializeCosmicCountdowns = () => {
    const cosmicEvents = document.querySelector<HTMLElement>(".cosmic-events")
    const focusAgiButton = cosmicEvents?.querySelector<HTMLButtonElement>("[data-focus-agi]")
    const focusSingularityButton = cosmicEvents?.querySelector<HTMLButtonElement>("[data-focus-singularity]")
    const countdowns = Array.from(document.querySelectorAll<HTMLElement>("[data-countdown]"))
    if (!cosmicEvents || countdowns.length === 0) return

    const deadlines: Record<string, number> = {
      agi: Date.parse("2027-10-01T00:00:00-07:00"),
      singularity: Date.parse("2050-01-01T00:00:00Z"),
    }
    const formatCountdown = (milliseconds: number) => {
      if (milliseconds <= 0) return "ARRIVED"
      const totalSeconds = Math.floor(milliseconds / 1000)
      const days = Math.floor(totalSeconds / 86400)
      const hours = Math.floor((totalSeconds % 86400) / 3600)
      const minutes = Math.floor((totalSeconds % 3600) / 60)
      const seconds = totalSeconds % 60
      return `${String(days).padStart(3, "0")}D ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`
    }
    const updateCountdowns = () => {
      const now = Date.now()
      countdowns.forEach((countdown) => {
        const deadline = deadlines[countdown.dataset.countdown ?? ""]
        if (deadline) countdown.textContent = formatCountdown(deadline - now)
      })
    }
    let interval = 0
    let orbitVisible = true
    const stopCountdown = () => {
      if (!interval) return
      window.clearInterval(interval)
      interval = 0
    }
    const startCountdown = () => {
      if (interval || document.hidden || !orbitVisible) return
      updateCountdowns()
      interval = window.setInterval(updateCountdowns, 1000)
    }
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      orbitVisible = entry?.isIntersecting ?? true
      if (orbitVisible) startCountdown()
      else stopCountdown()
    }, { threshold: 0.01 })
    visibilityObserver.observe(cosmicEvents.closest("#orbit") ?? cosmicEvents)
    const pageVisibilityHandler = () => {
      if (document.hidden) stopCountdown()
      else startCountdown()
    }
    document.addEventListener("visibilitychange", pageVisibilityHandler)
    startCountdown()
    const pauseHandler = (event: Event) => {
      const paused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused ?? true
      cosmicEvents.classList.toggle("cosmic-events-paused", paused)
    }
    window.addEventListener("globe:pause-state", pauseHandler)
    const focusAgi = () => window.dispatchEvent(new CustomEvent("orbital:focus-agi"))
    const focusSingularity = () => window.dispatchEvent(new CustomEvent("orbital:focus-singularity"))
    focusAgiButton?.addEventListener("click", focusAgi)
    focusSingularityButton?.addEventListener("click", focusSingularity)
  }

  initializeCosmicCountdowns()
</script>
