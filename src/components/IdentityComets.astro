<script>
  type OrbitConfig = {
    period: number
    radius: number
    inclination: number
    node: number
    phase: number
    scale: number
    direction: 1 | -1
  }

  type GlobePose = { rotation: number; tilt: number }
  type ProjectedOrbitPoint = {
    x: number
    y: number
    depth: number
    velocityX: number
    velocityY: number
  }

  type TrailLayer = {
    core: SVGPathElement
    glow: SVGPathElement
    dust: SVGPathElement
    gradient: SVGLinearGradientElement
  }

  type TrailSet = { front: TrailLayer; back: TrailLayer }
  type TrailStop = { offset: string; color: string; opacity: number }

  const svgNamespace = "http://www.w3.org/2000/svg"

  const initializeIdentityOrbits = () => {
    const crescent = document.getElementById("crescent")
    if (!crescent || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    crescent.querySelectorAll("[data-orbit-copy]").forEach((copy) => copy.remove())

    const comets = Array.from(crescent.querySelectorAll<HTMLElement>(".identity-comet"))
    if (comets.length === 0) return

    const orbitWindow = window as Window & { __identityOrbitCleanup?: () => void }
    orbitWindow.__identityOrbitCleanup?.()

    const deviceMemory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 8
    const constrainedDevice = window.matchMedia("(max-width: 700px)").matches || deviceMemory <= 4
    const frameInterval = constrainedDevice ? 50 : 33
    const orbitPlanes = [
      { period: 22000, radius: 0.54, inclination: 0.38, node: 1.57 },
      { period: 28000, radius: 0.6, inclination: -0.75, node: 1.22 },
      { period: 34000, radius: 0.66, inclination: 1.05, node: 1.9 },
    ]
    const planeCounts = orbitPlanes.map((_, planeIndex) =>
      comets.filter((_, cometIndex) => cometIndex % orbitPlanes.length === planeIndex).length
    )
    const planeSlots = orbitPlanes.map(() => 0)
    const planeOffsets = orbitPlanes.map(() => Math.random() * Math.PI * 2)
    const orbitConfigs: OrbitConfig[] = comets.map((comet, index) => {
      if (comet.classList.contains("agi-impact-comet")) {
        return {
          period: 52000,
          radius: 0.58,
          inclination: 0.45,
          node: 0.65,
          phase: 1.35,
          scale: 0.78,
          direction: -1,
        }
      }
      const planeIndex = index % orbitPlanes.length
      const plane = orbitPlanes[planeIndex]
      const slot = planeSlots[planeIndex]++
      const phaseSpacing = (Math.PI * 2) / planeCounts[planeIndex]
      const scale = index < 4 ? 1 : index < 9 ? 0.9 : 0.84
      return {
        period: plane.period * 1.3875 * (0.78 + Math.random() * 0.44),
        radius: plane.radius * (0.96 + Math.random() * 0.08),
        inclination: plane.inclination + (Math.random() - 0.5) * 0.14,
        node: plane.node + (Math.random() - 0.5) * 0.18,
        phase: planeOffsets[planeIndex] + slot * phaseSpacing + (Math.random() - 0.5) * 0.24,
        scale,
        direction: Math.random() > 0.5 ? 1 : -1,
      }
    })

    const telemetry = document.getElementById("comet-telemetry") as HTMLElement | null
    const telemetryName = telemetry?.querySelector<HTMLElement>("[data-telemetry-name]")
    const telemetryId = telemetry?.querySelector<HTMLElement>("[data-telemetry-id]")
    const telemetryVelocity = telemetry?.querySelector<HTMLElement>("[data-telemetry-velocity]")
    const identityCounts = new Map<string, number>()
    const identityMetadata = (comet: HTMLElement) => {
      if (comet.classList.contains("google-comet")) return { key: "GOOG", name: "Google" }
      if (comet.classList.contains("cornell-tech-comet")) return { key: "CT", name: "Cornell Tech" }
      if (comet.classList.contains("cornell-comet")) return { key: "CU", name: "Cornell" }
      if (comet.classList.contains("usa-comet")) return { key: "USA", name: "United States" }
      if (comet.classList.contains("china-comet")) return { key: "PRC", name: "China" }
      if (comet.classList.contains("gemini-comet")) return { key: "GEM", name: "Gemini" }
      if (comet.classList.contains("tesla-comet")) return { key: "TSLA", name: "Tesla" }
      if (comet.classList.contains("agi-impact-comet")) return { key: "AGI", name: "Artificial General Intelligence" }
      return { key: "MJOLNIR", name: "Master Chief" }
    }
    const telemetryCleanups: Array<() => void> = []
    if (telemetry && telemetryName && telemetryId && telemetryVelocity) {
      document.body.appendChild(telemetry)
      comets.forEach((comet, index) => {
        const mark = comet.firstElementChild as HTMLElement | null
        if (!mark) return
        const metadata = identityMetadata(comet)
        const ordinal = (identityCounts.get(metadata.key) ?? 0) + 1
        identityCounts.set(metadata.key, ordinal)
        const objectId = metadata.key === "MJOLNIR"
          ? "MJOLNIR-117"
          : metadata.key === "AGI"
            ? "AGI-ORBIT-001"
            : `${metadata.key}-${String(ordinal).padStart(3, "0")}`
        const config = orbitConfigs[index]
        const estimatedVelocity = 7.3 * (config.radius / 0.6) * (28000 / config.period)

        const moveTelemetry = (event: PointerEvent) => {
          telemetry.style.left = `${Math.min(window.innerWidth - 190, event.clientX + 14)}px`
          telemetry.style.top = `${Math.min(window.innerHeight - 106, event.clientY + 14)}px`
        }
        const showTelemetry = (event: PointerEvent) => {
          telemetryName.textContent = metadata.name
          telemetryId.textContent = objectId
          telemetryVelocity.textContent = `${estimatedVelocity.toFixed(2)} km/s`
          telemetry.hidden = false
          moveTelemetry(event)
        }
        const hideTelemetry = () => { telemetry.hidden = true }
        mark.addEventListener("pointerenter", showTelemetry)
        mark.addEventListener("pointermove", moveTelemetry)
        mark.addEventListener("pointerleave", hideTelemetry)
        telemetryCleanups.push(() => {
          mark.removeEventListener("pointerenter", showTelemetry)
          mark.removeEventListener("pointermove", moveTelemetry)
          mark.removeEventListener("pointerleave", hideTelemetry)
        })
      })
    }

    let focusedComet: HTMLElement | null = null
    let focusStartedAt = 0
    let returningComet: HTMLElement | null = null
    let returnStartedAt = 0
    const focusComet = (comet: HTMLElement) => {
      focusedComet = comet
      returningComet = null
      focusStartedAt = performance.now()
      window.dispatchEvent(new CustomEvent("globe:set-paused", { detail: { paused: true } }))
    }
    const focusAgiHandler = () => {
      const impactAsteroid = comets.find((comet) => comet.classList.contains("agi-impact-comet"))
      if (impactAsteroid) focusComet(impactAsteroid)
    }
    const orbitalClickHandler = (event: MouseEvent) => {
      const target = event.target
      if (!(target instanceof Element)) return
      const comet = target.closest<HTMLElement>(".identity-comet")
      const mark = comet?.firstElementChild
      if (!mark || (target !== mark && !mark.contains(target))) return
      if (comet.classList.contains("agi-impact-comet")) focusComet(comet)
      else window.dispatchEvent(new CustomEvent("globe:set-paused", { detail: { paused: true } }))
    }
    document.addEventListener("click", orbitalClickHandler)
    window.addEventListener("orbital:focus-agi", focusAgiHandler)

    const backTrails = document.getElementById("identity-trails-back") as SVGSVGElement | null
    const frontTrails = document.getElementById("identity-trails-front") as SVGSVGElement | null
    if (!backTrails || !frontTrails) return
    backTrails.replaceChildren()
    frontTrails.replaceChildren()

    const paletteFor = (comet: HTMLElement): TrailStop[] => {
      if (comet.classList.contains("google-comet")) return [
        { offset: "0%", color: "#451a03", opacity: 0 },
        { offset: "50%", color: "#b45309", opacity: 0.22 },
        { offset: "82%", color: "#fdba74", opacity: 0.5 },
        { offset: "100%", color: "#fff7ed", opacity: 0.82 },
      ]
      if (comet.classList.contains("cornell-comet")) return [
        { offset: "0%", color: "#450a0a", opacity: 0 },
        { offset: "58%", color: "#991b1b", opacity: 0.25 },
        { offset: "84%", color: "#fb923c", opacity: 0.48 },
        { offset: "100%", color: "#fff7ed", opacity: 0.8 },
      ]
      if (comet.classList.contains("usa-comet")) return [
        { offset: "0%", color: "#172554", opacity: 0 },
        { offset: "58%", color: "#7f1d1d", opacity: 0.2 },
        { offset: "84%", color: "#fdba74", opacity: 0.46 },
        { offset: "100%", color: "#fffaf0", opacity: 0.82 },
      ]
      if (comet.classList.contains("china-comet")) return [
        { offset: "0%", color: "#450a0a", opacity: 0 },
        { offset: "62%", color: "#7f1d1d", opacity: 0.18 },
        { offset: "86%", color: "#d97706", opacity: 0.34 },
        { offset: "100%", color: "#ffedd5", opacity: 0.64 },
      ]
      if (comet.classList.contains("gemini-comet")) return [
        { offset: "0%", color: "#312e81", opacity: 0 },
        { offset: "58%", color: "#6366f1", opacity: 0.2 },
        { offset: "84%", color: "#bae6fd", opacity: 0.44 },
        { offset: "100%", color: "#f0f9ff", opacity: 0.78 },
      ]
      if (comet.classList.contains("tesla-comet")) return [
        { offset: "0%", color: "#450a0a", opacity: 0 },
        { offset: "60%", color: "#991b1b", opacity: 0.22 },
        { offset: "84%", color: "#fb923c", opacity: 0.46 },
        { offset: "100%", color: "#fff7ed", opacity: 0.8 },
      ]
      if (comet.classList.contains("cornell-tech-comet")) return [
        { offset: "0%", color: "#450a0a", opacity: 0 },
        { offset: "60%", color: "#991b1b", opacity: 0.22 },
        { offset: "84%", color: "#fdba74", opacity: 0.46 },
        { offset: "100%", color: "#fff7ed", opacity: 0.8 },
      ]
      if (comet.classList.contains("agi-impact-comet")) return [
        { offset: "0%", color: "#292524", opacity: 0 },
        { offset: "58%", color: "#57534e", opacity: 0.16 },
        { offset: "84%", color: "#a8a29e", opacity: 0.34 },
        { offset: "100%", color: "#fed7aa", opacity: 0.62 },
      ]
      return [
        { offset: "0%", color: "#14532d", opacity: 0 },
        { offset: "58%", color: "#3f6212", opacity: 0.2 },
        { offset: "84%", color: "#fbbf24", opacity: 0.44 },
        { offset: "100%", color: "#fef3c7", opacity: 0.78 },
      ]
    }

    const createTrailLayer = (
      svg: SVGSVGElement,
      side: "front" | "back",
      index: number,
      palette: TrailStop[],
    ): TrailLayer => {
      const gradient = document.createElementNS(svgNamespace, "linearGradient")
      gradient.id = `identity-trail-${side}-${index}`
      gradient.setAttribute("gradientUnits", "userSpaceOnUse")
      palette.forEach(({ offset, color, opacity }) => {
        const stop = document.createElementNS(svgNamespace, "stop")
        stop.setAttribute("offset", offset)
        stop.setAttribute("stop-color", color)
        stop.setAttribute("stop-opacity", String(opacity))
        gradient.appendChild(stop)
      })

      const definitions = document.createElementNS(svgNamespace, "defs")
      definitions.appendChild(gradient)
      const glow = document.createElementNS(svgNamespace, "path")
      glow.classList.add("identity-trail", "identity-trail-glow")
      glow.setAttribute("stroke", `url(#${gradient.id})`)
      glow.setAttribute("stroke-width", constrainedDevice ? "12" : "18")
      const dust = document.createElementNS(svgNamespace, "path")
      dust.classList.add("identity-trail", "identity-trail-dust")
      dust.setAttribute("stroke", `url(#${gradient.id})`)
      dust.setAttribute("stroke-width", constrainedDevice ? "3" : "4.5")
      const core = document.createElementNS(svgNamespace, "path")
      core.classList.add("identity-trail", "identity-trail-core")
      core.setAttribute("stroke", `url(#${gradient.id})`)
      core.setAttribute("stroke-width", constrainedDevice ? "3.5" : "5")
      svg.append(definitions, glow, dust, core)
      return { core, glow, dust, gradient }
    }

    const trailSets: TrailSet[] = comets.map((comet, index) => {
      const palette = paletteFor(comet)
      return {
        front: createTrailLayer(frontTrails, "front", index, palette),
        back: createTrailLayer(backTrails, "back", index, palette),
      }
    })

    const startTime = performance.now()
    let orbitVisible = true
    let orbitPaused = false
    let pauseStartedAt = 0
    let totalPausedTime = 0
    let animationFrame = 0
    let lastDraw = -Infinity

    const pauseStateHandler = (event: Event) => {
      const nextPaused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused ?? true
      if (nextPaused === orbitPaused) return

      const now = performance.now()
      if (nextPaused) {
        pauseStartedAt = now
      } else {
        totalPausedTime += now - pauseStartedAt
        if (focusedComet) {
          returningComet = focusedComet
          returnStartedAt = now
        }
        focusedComet = null
      }
      orbitPaused = nextPaused
      crescent.classList.toggle("identity-orbits-paused", orbitPaused)
    }
    window.addEventListener("globe:pause-state", pauseStateHandler)

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      orbitVisible = entry?.isIntersecting ?? true
    }, { threshold: 0.01 })
    visibilityObserver.observe(crescent)

    const projectOrbit = (
      theta: number,
      config: OrbitConfig,
      pose: GlobePose,
      radius: number,
    ): ProjectedOrbitPoint => {
      const cosineTheta = Math.cos(theta)
      const sineTheta = Math.sin(theta)
      const cosineInclination = Math.cos(config.inclination)
      const sineInclination = Math.sin(config.inclination)
      const cosineNode = Math.cos(config.node)
      const sineNode = Math.sin(config.node)

      const orbitX = cosineTheta
      const inclinedY = sineTheta * cosineInclination
      const orbitZ = sineTheta * sineInclination
      const worldX = orbitX * cosineNode - inclinedY * sineNode
      const worldY = orbitX * sineNode + inclinedY * cosineNode
      const worldZ = orbitZ

      const tangentOrbitX = -sineTheta * config.direction
      const tangentInclinedY = cosineTheta * cosineInclination * config.direction
      const tangentOrbitZ = cosineTheta * sineInclination * config.direction
      const tangentWorldX = tangentOrbitX * cosineNode - tangentInclinedY * sineNode
      const tangentWorldY = tangentOrbitX * sineNode + tangentInclinedY * cosineNode
      const tangentWorldZ = tangentOrbitZ

      const cosineYaw = Math.cos(pose.rotation)
      const sineYaw = Math.sin(pose.rotation)
      const cosinePitch = Math.cos(pose.tilt)
      const sinePitch = Math.sin(pose.tilt)
      const yawX = worldX * cosineYaw - worldZ * sineYaw
      const yawZ = worldX * sineYaw + worldZ * cosineYaw
      const screenY = worldY * cosinePitch - yawZ * sinePitch
      const depth = worldY * sinePitch + yawZ * cosinePitch
      const tangentYawX = tangentWorldX * cosineYaw - tangentWorldZ * sineYaw
      const tangentYawZ = tangentWorldX * sineYaw + tangentWorldZ * cosineYaw
      const tangentScreenY = tangentWorldY * cosinePitch - tangentYawZ * sinePitch

      return {
        x: yawX * radius,
        y: -screenY * radius,
        depth,
        velocityX: tangentYawX,
        velocityY: -tangentScreenY,
      }
    }

    const updateTrailLayer = (
      layer: TrailLayer,
      commands: string[],
      tail: ProjectedOrbitPoint,
      head: ProjectedOrbitPoint,
      centerX: number,
      centerY: number,
    ) => {
      const path = commands.join(" ")
      layer.core.setAttribute("d", path)
      layer.glow.setAttribute("d", path)
      layer.dust.setAttribute("d", path)
      layer.gradient.setAttribute("x1", String(centerX + tail.x))
      layer.gradient.setAttribute("y1", String(centerY + tail.y))
      layer.gradient.setAttribute("x2", String(centerX + head.x))
      layer.gradient.setAttribute("y2", String(centerY + head.y))
    }

    const draw = (now: number) => {
      if (orbitVisible && now - lastDraw >= frameInterval) {
        const width = crescent.clientWidth
        const height = crescent.clientHeight
        const globePose = (window as Window & {
          __earthGlobePose?: { rotation: number; tilt: number }
        }).__earthGlobePose ?? { rotation: 0, tilt: 0 }
        const animationTime = orbitPaused ? pauseStartedAt : now
        const elapsed = animationTime - startTime - totalPausedTime
        const centerX = width / 2
        const centerY = height / 2
        const trailSamples = constrainedDevice ? 9 : 15
        const trailArc = constrainedDevice ? 0.36 : 0.46
        backTrails.setAttribute("viewBox", `0 0 ${width} ${height}`)
        frontTrails.setAttribute("viewBox", `0 0 ${width} ${height}`)

        comets.forEach((comet, index) => {
          const config = orbitConfigs[index]
          const theta = config.phase + config.direction * (elapsed / config.period) * Math.PI * 2
          const isImpactAsteroid = comet.classList.contains("agi-impact-comet")
          const radius = Math.min(width, height) * config.radius
          const head = projectOrbit(theta, config, globePose, radius)
          const tangentAngle = Math.atan2(head.velocityY, head.velocityX) * 180 / Math.PI + 180
          let depthScale = config.scale * (0.8 + ((head.depth + 1) / 2) * 0.26)
          if (constrainedDevice) depthScale *= 0.82
          let focusDeltaX = 0
          let focusDeltaY = 0
          let focusWeight = 0
          if (focusedComet === comet) {
            const linearFocus = Math.min(1, Math.max(0, (now - focusStartedAt) / 720))
            focusWeight = linearFocus * linearFocus * (3 - 2 * linearFocus)
          } else if (returningComet === comet) {
            const linearReturn = Math.min(1, Math.max(0, (now - returnStartedAt) / 720))
            const returnProgress = linearReturn * linearReturn * (3 - 2 * linearReturn)
            focusWeight = 1 - returnProgress
            if (linearReturn >= 1) returningComet = null
          }
          if (focusWeight > 0) {
            const visualRect = crescent.getBoundingClientRect()
            const visualScale = Math.max(0.001, visualRect.width / Math.max(1, width))
            const targetX = (window.innerWidth / 2 - (visualRect.left + visualRect.width / 2)) / visualScale
            const targetY = (window.innerHeight * 0.46 - (visualRect.top + visualRect.height / 2)) / visualScale
            focusDeltaX = (targetX - head.x) * focusWeight
            focusDeltaY = (targetY - head.y) * focusWeight
            head.x += focusDeltaX
            head.y += focusDeltaY
            depthScale *= 1 + focusWeight * (isImpactAsteroid ? 1.05 : 0.12)
          }

          const points: ProjectedOrbitPoint[] = []
          for (let sample = 0; sample < trailSamples; sample += 1) {
            const progress = sample / (trailSamples - 1)
            const sampleTheta = theta - config.direction * trailArc * (1 - progress)
            const point = projectOrbit(sampleTheta, config, globePose, radius)
            const turbulence = (1 - progress) * (constrainedDevice ? 3.5 : 7)
            point.x += Math.sin(now * 0.0042 + index * 1.91 + sample * 1.37) * turbulence
            point.y += Math.cos(now * 0.0034 + index * 1.17 + sample * 1.73) * turbulence * 0.58
            point.x += focusDeltaX
            point.y += focusDeltaY
            points.push(point)
          }
          const trailHead = points[points.length - 1]
          const trailPrevious = points[points.length - 2]
          if (trailHead && trailPrevious) {
            const trailDeltaX = trailHead.x - trailPrevious.x
            const trailDeltaY = trailHead.y - trailPrevious.y
            const trailDistance = Math.max(0.001, Math.hypot(trailDeltaX, trailDeltaY))
            const bodyGap = Math.min(trailDistance * 0.82, 34 * depthScale)
            trailHead.x -= (trailDeltaX / trailDistance) * bodyGap
            trailHead.y -= (trailDeltaY / trailDistance) * bodyGap
          }
          const frontCommands: string[] = []
          const backCommands: string[] = []
          for (let sample = 1; sample < points.length; sample += 1) {
            const previous = points[sample - 1]
            const current = points[sample]
            const commands = (previous.depth + current.depth) / 2 >= 0 ? frontCommands : backCommands
            commands.push(
              `M ${(centerX + previous.x).toFixed(1)} ${(centerY + previous.y).toFixed(1)}`,
              `L ${(centerX + current.x).toFixed(1)} ${(centerY + current.y).toFixed(1)}`,
            )
          }
          const tail = points[0]
          const trails = trailSets[index]
          updateTrailLayer(trails.front, frontCommands, tail, trailHead ?? head, centerX, centerY)
          updateTrailLayer(trails.back, backCommands, tail, trailHead ?? head, centerX, centerY)

          comet.style.setProperty("--counter-rotation", `${-tangentAngle}deg`)
          comet.style.transform = `translate(-50%, -50%) translate3d(${head.x.toFixed(1)}px, ${head.y.toFixed(1)}px, 0) rotate(${tangentAngle.toFixed(2)}deg) scale(${depthScale.toFixed(3)})`
          const orbitalOpacity = 0.62 + ((head.depth + 1) / 2) * 0.38
          const colorMute = isImpactAsteroid ? 1 : comet.classList.contains("china-comet") ? 0.5 : 0.62
          comet.style.opacity = focusedComet === comet ? "1" : (orbitalOpacity * colorMute).toFixed(3)
          comet.style.zIndex = focusedComet === comet ? "80" : head.depth >= 0 ? "22" : "6"
        })
        lastDraw = now
      }
      animationFrame = window.requestAnimationFrame(draw)
    }

    animationFrame = window.requestAnimationFrame(draw)
    orbitWindow.__identityOrbitCleanup = () => {
      visibilityObserver.disconnect()
      window.removeEventListener("globe:pause-state", pauseStateHandler)
      window.removeEventListener("orbital:focus-agi", focusAgiHandler)
      document.removeEventListener("click", orbitalClickHandler)
      window.cancelAnimationFrame(animationFrame)
      telemetryCleanups.forEach((cleanup) => cleanup())
      telemetry?.remove()
    }
  }

  document.addEventListener("astro:after-swap", initializeIdentityOrbits)
  initializeIdentityOrbits()
</script>
