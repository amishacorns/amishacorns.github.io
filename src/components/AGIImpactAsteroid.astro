---
import OrbitalFocusCard from "@components/OrbitalFocusCard.astro"
---

<div id="inbound-agi" class="identity-comet agi-impact-comet inbound-agi" data-object-key="AGI" data-object-name="Superintelligence">
  <button class="inbound-agi-object" type="button" aria-label="Focus superintelligence">
    <canvas class="agi-asteroid-mesh" width="288" height="288" aria-hidden="true"></canvas>
    <span class="sr-only">Focus superintelligence</span>
  </button>
  <OrbitalFocusCard
    kicker="Inbound Object"
    title="Superintelligence"
    rows={[
      { label: "Object ID", value: "SI-2027" },
      { label: "Velocity", value: "17.82 km/s" },
      { label: "Impact Date", value: "01 Oct 2027" },
    ]}
    definition="Here, superintelligence means a system that outperforms the best human at every intellectual task, including unfamiliar tasks it must learn rather than tasks it has already seen."
    countdownMeaning="The timer ends at my forecast for when this minimum threshold is first crossed. It marks the arrival of the capability, not universal access, adoption, or deployment."
    context="This is deliberately stricter than many common definitions of superintelligence."
  />
</div>

<style>
  .inbound-agi {
    --focus-card-top: calc(100% + 0.75rem);
    @apply pointer-events-none absolute left-1/2 top-1/2 z-[14];
    width: 20rem;
    height: 20rem;
    opacity: 0;
    will-change: transform, opacity;
  }

  .inbound-agi-object {
    @apply pointer-events-auto absolute inset-0 cursor-crosshair border-0 bg-transparent p-0;
    transform: rotate(var(--counter-rotation, 0deg));
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.72)) drop-shadow(0 0 16px rgb(251 146 60 / 0.24));
  }

  .agi-asteroid-mesh {
    @apply pointer-events-none absolute -inset-[8%] h-[116%] w-[116%];
    opacity: 0;
    transition: opacity 360ms ease;
  }

  .agi-asteroid-mesh.ready {
    opacity: 1;
  }

  .inbound-agi.agi-focused {
    opacity: 1 !important;
  }

  .inbound-agi.agi-focused .inbound-agi-object {
    cursor: grab;
    touch-action: none;
  }

  .inbound-agi.agi-focused .inbound-agi-object.dragging {
    cursor: grabbing;
  }

  @media (max-width: 700px) {
    .inbound-agi { width: 15rem; height: 15rem; }
  }
</style>

<script>
  const initializeAsteroidMesh = () => {
    const canvas = document.querySelector<HTMLCanvasElement>(".agi-asteroid-mesh")
    if (!canvas || canvas.dataset.initialized) return
    canvas.dataset.initialized = "true"

    const gl = canvas.getContext("webgl", { alpha: true, antialias: true, premultipliedAlpha: true })
    if (!gl) return
    gl.viewport(0, 0, canvas.width, canvas.height)

    const asteroidContainer = canvas.closest("#inbound-agi")

    const vertexSource = `
      attribute vec3 aPosition;
      attribute vec3 aNormal;
      attribute vec2 aUv;
      uniform vec3 uAngles;
      varying vec3 vNormal;
      varying vec3 vPosition;
      varying vec2 vUv;

      vec3 tumble(vec3 p) {
        float cx = cos(uAngles.x), sx = sin(uAngles.x);
        float cy = cos(uAngles.y), sy = sin(uAngles.y);
        float cz = cos(uAngles.z), sz = sin(uAngles.z);
        p = vec3(p.x, cx * p.y - sx * p.z, sx * p.y + cx * p.z);
        p = vec3(cy * p.x + sy * p.z, p.y, -sy * p.x + cy * p.z);
        return vec3(cz * p.x - sz * p.y, sz * p.x + cz * p.y, p.z);
      }

      void main() {
        vec3 position = tumble(aPosition);
        vNormal = normalize(tumble(aNormal));
        vPosition = position;
        vUv = aUv;
        float perspective = 1.72 / (3.55 - position.z);
        gl_Position = vec4(position.xy * perspective, -position.z * 0.12, 1.0);
      }
    `

    const fragmentSource = `
      precision mediump float;
      uniform sampler2D uSurface;
      varying vec3 vNormal;
      varying vec3 vPosition;
      varying vec2 vUv;

      void main() {
        vec3 surfaceColor = texture2D(uSurface, vUv).rgb;
        float textureValue = dot(surfaceColor, vec3(0.2126, 0.7152, 0.0722));
        float textureEast = texture2D(uSurface, vUv + vec2(0.0024, 0.0)).r;
        float textureNorth = texture2D(uSurface, vUv + vec2(0.0, 0.0024)).r;
        vec3 normal = normalize(vNormal + vec3((textureValue - textureEast) * 0.8, (textureValue - textureNorth) * 0.8, 0.0));
        vec3 lightDirection = normalize(vec3(-0.72, 0.58, 0.82));
        float diffuse = max(dot(normal, lightDirection), 0.0);
        float halfLight = max(dot(normal, normalize(lightDirection + vec3(0.0, 0.0, 1.0))), 0.0);
        float grain = mix(0.62, 1.28, textureValue);
        vec3 rock = mix(surfaceColor, vec3(textureValue), 0.12);
        float cavity = smoothstep(-0.28, 0.7, normal.z);
        vec3 color = rock * (0.17 + diffuse * 0.9) * grain * mix(0.8, 1.0, cavity);
        color += vec3(0.34, 0.215, 0.12) * pow(halfLight, 18.0) * 0.16;
        float rim = pow(1.0 - max(normal.z, 0.0), 3.5);
        color += vec3(0.22, 0.115, 0.055) * rim * 0.1;
        gl_FragColor = vec4(color, 1.0);
      }
    `

    const compileShader = (type: number, source: string) => {
      const shader = gl.createShader(type)
      if (!shader) return null
      gl.shaderSource(shader, source)
      gl.compileShader(shader)
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        gl.deleteShader(shader)
        return null
      }
      return shader
    }

    const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource)
    const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource)
    if (!vertexShader || !fragmentShader) return
    const program = gl.createProgram()
    if (!program) return
    gl.attachShader(program, vertexShader)
    gl.attachShader(program, fragmentShader)
    gl.linkProgram(program)
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return

    type Crater = {
      direction: [number, number, number]
      depth: number
      coreCosine: number
      rimCosine: number
    }
    const direction = (longitude: number, latitude: number): [number, number, number] => {
      const latitudeCosine = Math.cos(latitude)
      return [latitudeCosine * Math.cos(longitude), Math.sin(latitude), latitudeCosine * Math.sin(longitude)]
    }
    const crater = (longitude: number, latitude: number, radius: number, depth: number): Crater => ({
      direction: direction(longitude, latitude),
      depth,
      coreCosine: Math.cos(radius),
      rimCosine: Math.cos(radius * 1.28),
    })
    const craters: Crater[] = [
      crater(0.28, 0.35, 0.34, 0.18),
      crater(-0.72, -0.08, 0.22, 0.12),
      crater(1.16, -0.48, 0.18, 0.105),
      crater(2.02, 0.23, 0.25, 0.13),
      crater(-2.14, 0.56, 0.14, 0.08),
      crater(0.91, 0.7, 0.12, 0.07),
      crater(-1.44, -0.62, 0.17, 0.09),
      crater(2.62, -0.24, 0.09, 0.05),
      crater(-2.7, -0.3, 0.08, 0.045),
      crater(1.72, 0.58, 0.1, 0.055),
      crater(-0.18, -0.72, 0.075, 0.04),
      crater(0.56, -0.31, 0.105, 0.06),
    ]

    const compactMesh = window.matchMedia("(max-width: 700px)").matches
    const latitudeSegments = compactMesh ? 28 : 56
    const longitudeSegments = compactMesh ? 42 : 84
    const positions: number[] = []
    const normals: number[] = []
    const uvs: number[] = []
    const indices: number[] = []

    for (let latitudeIndex = 0; latitudeIndex <= latitudeSegments; latitudeIndex += 1) {
      const v = latitudeIndex / latitudeSegments
      const theta = v * Math.PI
      const sineTheta = Math.sin(theta)
      const cosineTheta = Math.cos(theta)
      for (let longitudeIndex = 0; longitudeIndex <= longitudeSegments; longitudeIndex += 1) {
        const u = longitudeIndex / longitudeSegments
        const phi = u * Math.PI * 2
        const nx = sineTheta * Math.cos(phi)
        const ny = cosineTheta
        const nz = sineTheta * Math.sin(phi)

        const rockyShape =
          0.052 * Math.sin(nx * 4.3 + ny * 2.1 - nz * 3.7 + 0.4) +
          0.032 * Math.sin(nx * 7.1 - ny * 5.3 + nz * 2.9 - 0.7) +
          0.022 * Math.sin((nx + ny - nz) * 12.4) +
          0.011 * Math.sin((nx * 1.7 - ny * 0.8 + nz * 1.3) * 23.6) +
          0.006 * Math.sin((nx - ny * 1.4 - nz * 0.6) * 38.2)
        let radius = (1 + rockyShape) * (1 + nx * 0.045 - ny * 0.025)

        for (const crater of craters) {
          const dot = Math.max(-1, Math.min(1, nx * crater.direction[0] + ny * crater.direction[1] + nz * crater.direction[2]))
          if (dot > crater.coreCosine) {
            const normalizedDistance = Math.sqrt((1 - dot) / (1 - crater.coreCosine))
            radius -= crater.depth * Math.pow(1 - normalizedDistance * normalizedDistance, 2)
          } else if (dot > crater.rimCosine) {
            const rimPosition = (crater.coreCosine - dot) / (crater.coreCosine - crater.rimCosine)
            radius += crater.depth * 0.24 * Math.sin(rimPosition * Math.PI)
          }
        }

        const chippedEdge = Math.max(0, 1 - Math.hypot(nx - 0.55, ny + 0.48, nz - 0.34) / 0.34)
        radius -= chippedEdge * 0.12
        positions.push(nx * radius * 1.12, ny * radius * 0.96, nz * radius * 0.92)
        normals.push(0, 0, 0)
        uvs.push(u, 1 - v)
      }
    }

    for (let latitudeIndex = 0; latitudeIndex < latitudeSegments; latitudeIndex += 1) {
      for (let longitudeIndex = 0; longitudeIndex < longitudeSegments; longitudeIndex += 1) {
        const first = latitudeIndex * (longitudeSegments + 1) + longitudeIndex
        const second = first + longitudeSegments + 1
        indices.push(first, first + 1, second, second, first + 1, second + 1)
      }
    }

    for (let index = 0; index < indices.length; index += 3) {
      const a = indices[index] * 3
      const b = indices[index + 1] * 3
      const c = indices[index + 2] * 3
      const abx = positions[b] - positions[a]
      const aby = positions[b + 1] - positions[a + 1]
      const abz = positions[b + 2] - positions[a + 2]
      const acx = positions[c] - positions[a]
      const acy = positions[c + 1] - positions[a + 1]
      const acz = positions[c + 2] - positions[a + 2]
      const normalX = aby * acz - abz * acy
      const normalY = abz * acx - abx * acz
      const normalZ = abx * acy - aby * acx
      for (const vertex of [a, b, c]) {
        normals[vertex] += normalX
        normals[vertex + 1] += normalY
        normals[vertex + 2] += normalZ
      }
    }
    for (let index = 0; index < normals.length; index += 3) {
      const length = Math.hypot(normals[index], normals[index + 1], normals[index + 2]) || 1
      normals[index] /= length
      normals[index + 1] /= length
      normals[index + 2] /= length
    }

    const bindAttribute = (name: string, values: Float32Array, size: number) => {
      const buffer = gl.createBuffer()
      const location = gl.getAttribLocation(program, name)
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
      gl.bufferData(gl.ARRAY_BUFFER, values, gl.STATIC_DRAW)
      gl.enableVertexAttribArray(location)
      gl.vertexAttribPointer(location, size, gl.FLOAT, false, 0, 0)
    }
    gl.useProgram(program)
    bindAttribute("aPosition", new Float32Array(positions), 3)
    bindAttribute("aNormal", new Float32Array(normals), 3)
    bindAttribute("aUv", new Float32Array(uvs), 2)
    const indexBuffer = gl.createBuffer()
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer)
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(indices), gl.STATIC_DRAW)

    const texture = gl.createTexture()
    gl.bindTexture(gl.TEXTURE_2D, texture)
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR)
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([104, 104, 104, 255]))
    gl.generateMipmap(gl.TEXTURE_2D)

    const surfaceImage = new Image()
    surfaceImage.decoding = "async"
    surfaceImage.onload = () => {
      gl.bindTexture(gl.TEXTURE_2D, texture)
      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, 1)
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, surfaceImage)
      gl.generateMipmap(gl.TEXTURE_2D)
    }
    surfaceImage.src = "/images/agi-asteroid-surface-v2.webp"

    const anglesLocation = gl.getUniformLocation(program, "uAngles")
    gl.uniform1i(gl.getUniformLocation(program, "uSurface"), 0)
    gl.enable(gl.DEPTH_TEST)
    gl.enable(gl.CULL_FACE)
    gl.cullFace(gl.BACK)
    gl.clearColor(0, 0, 0, 0)

    let paused = false
    let orbitScrolling = false
    let asteroidVisible = true
    let lastTime = performance.now()
    let angleX = 0.31
    let angleY = -0.72
    let angleZ = -0.16
    let dragging = false
    let dragDistance = 0
    let previousPointerX = 0
    let previousPointerY = 0
    let suppressClick = false
    let animationFrame = 0
    let lastDraw = -Infinity
    let resumeAsteroid = () => {}
    const restingFrameInterval = compactMesh ? 66 : 42
    const focusedFrameInterval = compactMesh ? 42 : 33
    let adaptiveRestingFrameInterval = restingFrameInterval
    let previousAnimationTick = performance.now()
    let slowAnimationTicks = 0
    let recoveredAnimationTicks = 0
    const render = (time: number) => {
      animationFrame = 0
      const focused = asteroidContainer?.classList.contains("agi-focused") ?? false
      const tickGap = time - previousAnimationTick
      previousAnimationTick = time
      if (compactMesh && !focused) {
        if (tickGap > 24) {
          slowAnimationTicks += 1
          recoveredAnimationTicks = 0
        } else {
          slowAnimationTicks = Math.max(0, slowAnimationTicks - 1)
          if (adaptiveRestingFrameInterval > restingFrameInterval) recoveredAnimationTicks += 1
        }
        if (slowAnimationTicks >= 6) adaptiveRestingFrameInterval = 500
        else if (recoveredAnimationTicks >= 180) {
          adaptiveRestingFrameInterval = restingFrameInterval
          recoveredAnimationTicks = 0
        }
      }
      const frameInterval = focused ? focusedFrameInterval : adaptiveRestingFrameInterval
      const objectsVisible = (window as Window & { __orbitObjectsVisible?: boolean }).__orbitObjectsVisible ?? true
      if (asteroidVisible && (objectsVisible || focused) && (!orbitScrolling || focused) && time - lastDraw >= frameInterval) {
        const elapsed = Math.min(80, time - lastTime)
        lastTime = time
        if ((!paused || focused) && !dragging) {
          angleX += elapsed * 0.000075
          angleY += elapsed * 0.00016
          angleZ += elapsed * 0.000045
        }
        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT)
        gl.uniform3f(anglesLocation, angleX, angleY, angleZ)
        gl.drawElements(gl.TRIANGLES, indices.length, gl.UNSIGNED_SHORT, 0)
        canvas.classList.add("ready")
        lastDraw = time
      }
      resumeAsteroid()
    }
    const pauseState = (event: Event) => {
      paused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused ?? true
    }
    const orbitScrollState = (event: Event) => {
      orbitScrolling = (event as CustomEvent<{ scrolling?: boolean }>).detail?.scrolling ?? false
    }
    window.addEventListener("globe:pause-state", pauseState)
    window.addEventListener("orbit:scroll-state", orbitScrollState)
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      asteroidVisible = entry?.isIntersecting ?? true
      if (asteroidVisible) resumeAsteroid()
      else if (animationFrame) {
        cancelAnimationFrame(animationFrame)
        animationFrame = 0
      }
    }, { threshold: 0.01 })
    visibilityObserver.observe(canvas.closest("#orbit") ?? canvas)
    resumeAsteroid = () => {
      if (!animationFrame && asteroidVisible) {
        animationFrame = requestAnimationFrame(render)
      }
    }
    resumeAsteroid()

    const asteroid = canvas.closest<HTMLButtonElement>(".inbound-agi-object")
    const pointerDown = (event: PointerEvent) => {
      if (!asteroidContainer?.classList.contains("agi-focused") || !asteroid) return
      dragging = true
      dragDistance = 0
      previousPointerX = event.clientX
      previousPointerY = event.clientY
      asteroid.classList.add("dragging")
      asteroid.setPointerCapture(event.pointerId)
      event.preventDefault()
    }
    const pointerMove = (event: PointerEvent) => {
      if (!dragging) return
      const deltaX = event.clientX - previousPointerX
      const deltaY = event.clientY - previousPointerY
      dragDistance += Math.abs(deltaX) + Math.abs(deltaY)
      angleY += deltaX * 0.011
      angleX += deltaY * 0.011
      previousPointerX = event.clientX
      previousPointerY = event.clientY
      event.preventDefault()
    }
    const pointerUp = (event: PointerEvent) => {
      if (!dragging || !asteroid) return
      dragging = false
      suppressClick = dragDistance > 4
      window.setTimeout(() => { suppressClick = false }, 0)
      asteroid.classList.remove("dragging")
      if (asteroid.hasPointerCapture(event.pointerId)) asteroid.releasePointerCapture(event.pointerId)
      event.preventDefault()
    }
    asteroid?.addEventListener("pointerdown", pointerDown)
    asteroid?.addEventListener("pointermove", pointerMove)
    asteroid?.addEventListener("pointerup", pointerUp)
    asteroid?.addEventListener("pointercancel", pointerUp)
    asteroid?.addEventListener("click", (event) => {
      if (!suppressClick) return
      suppressClick = false
      event.preventDefault()
      event.stopImmediatePropagation()
    })

  }

  const initializeInboundAgi = () => {
    const container = document.getElementById("inbound-agi")
    const asteroid = container?.querySelector<HTMLButtonElement>(".inbound-agi-object")
    const focusCard = container?.querySelector<HTMLElement>(".orbital-focus-card")
    const stage = document.getElementById("orbit-stage")
    if (!container || !asteroid) return
    const focus = () => {
      window.dispatchEvent(new CustomEvent("orbital:focus-mode", { detail: { target: "agi" } }))
      container.classList.add("agi-focused")
      if (focusCard && stage) {
        stage.appendChild(focusCard)
        focusCard.classList.add("focus-card-overlay")
      }
      window.dispatchEvent(new CustomEvent("globe:set-paused", { detail: { paused: true } }))
    }
    const clearFocus = () => {
      container.classList.remove("agi-focused")
      if (focusCard) {
        focusCard.querySelector("details")?.removeAttribute("open")
        focusCard.classList.remove("focus-card-overlay")
        container.appendChild(focusCard)
      }
    }
    const pauseState = (event: Event) => {
      const paused = (event as CustomEvent<{ paused?: boolean }>).detail?.paused ?? true
      if (!paused) clearFocus()
    }

    asteroid.addEventListener("click", focus)
    window.addEventListener("orbital:focus-agi", focus)
    window.addEventListener("orbital:clear-focus", clearFocus)
    window.addEventListener("globe:pause-state", pauseState)
  }

  initializeAsteroidMesh()
  initializeInboundAgi()
</script>
