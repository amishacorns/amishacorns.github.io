---
import type { CollectionEntry } from "astro:content"
import ArrowCard from "@components/ArrowCard.astro"

interface Props {
  data: CollectionEntry<"blog">[]
}

const { data } = Astro.props
const searchText = (entry: CollectionEntry<"blog">) => [
  entry.slug,
  entry.data.title,
  entry.data.description,
  ...entry.data.tags,
].join(" ").toLowerCase()
---

<div class="flex flex-col" data-search-root>
  <div class="relative">
    <svg class="pointer-events-none absolute left-2 top-[0.45rem] size-6 stroke-neutral-500"><use href="/ui.svg#search"></use></svg>
    <input data-search-input name="search" type="search" autocomplete="off" spellcheck="false" placeholder="What are you looking for?" class="w-full rounded border border-white/10 bg-white/10 py-1.5 pl-10 pr-10 text-white outline-none placeholder-neutral-500 hover:bg-white/15 focus:border-white/40 focus:bg-white/15" />
    <button data-search-clear type="button" aria-label="Clear search" hidden class="absolute right-0 top-0 flex h-full w-10 items-center justify-center stroke-neutral-500 hover:stroke-neutral-300">
      <svg class="size-5"><use href="/ui.svg#x"></use></svg>
    </button>
  </div>

  <div data-search-results class="mt-12" hidden>
    <div data-search-status class="mb-2 text-sm uppercase" aria-live="polite"></div>
    <ul class="flex flex-col gap-3">
      {data.map((entry) => (
        <li data-search-item data-search={searchText(entry)} hidden>
          <ArrowCard entry={entry} pill />
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-search-root]")
  const input = root?.querySelector<HTMLInputElement>("[data-search-input]")
  const clear = root?.querySelector<HTMLButtonElement>("[data-search-clear]")
  const results = root?.querySelector<HTMLElement>("[data-search-results]")
  const status = root?.querySelector<HTMLElement>("[data-search-status]")
  const items = Array.from(root?.querySelectorAll<HTMLElement>("[data-search-item]") ?? [])
  let tracked = false

  const update = () => {
    if (!input || !clear || !results || !status) return
    const query = input.value.trim().toLowerCase()
    const tokens = query.split(/\s+/).filter(Boolean)
    const searching = query.length >= 2
    let count = 0

    items.forEach((item) => {
      const matches = searching && tokens.every((token) => item.dataset.search?.includes(token))
      item.hidden = !matches
      if (matches) count += 1
    })
    clear.hidden = input.value.length === 0
    results.hidden = !searching
    status.textContent = searching ? `Found ${count} result${count === 1 ? "" : "s"} for '${input.value}'` : ""

    if (searching && !tracked) {
      tracked = true
      ;(window as unknown as { plausible?: (event: string) => void }).plausible?.("Search Used")
    }
  }

  input?.addEventListener("input", update)
  clear?.addEventListener("click", () => {
    if (!input) return
    input.value = ""
    input.focus()
    update()
  })
</script>
