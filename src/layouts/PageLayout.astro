---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import RealStarField from "@components/RealStarField.astro"
const { title, description, image, imageAlt, type, publishedTime, tags } = Astro.props
const isHome = title === "Home"
const pageTitle = isHome ? `${SITE.TITLE} — Neural Architect` : `${title} | ${SITE.TITLE}`
import { SITE } from "@consts"
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={pageTitle} headline={title} description={description} image={image} imageAlt={imageAlt} type={type} publishedTime={publishedTime} tags={tags} />
  </head>
  <body>
    <a class="skip-link" href="#main-content-root">Skip to content</a>
    <div class:list={["site-star-field", isHome && "site-star-field-home"]}>
      <RealStarField />
    </div>
    <Header />
    <Drawer />
    <main id="main-content-root">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-star-field {
    @apply pointer-events-none fixed inset-0 z-0 overflow-hidden;
    opacity: 0.42;
  }

  .site-star-field-home { opacity: 1; }
  :global(main), :global(footer) { @apply relative z-10; }
</style>
